              <TextBlock x:Uid="Devices.DropHint" Style="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0"/>
              <Button x:Name="DevAddFileBtn" x:Uid="Devices.AddFile"/>
            </StackPanel>
          </Grid>
          <Border Grid.Row="3" Style="{StaticResource Card}" Padding="4">
            <DataGrid x:Name="DevIpaGrid" SelectionMode="Extended">
              <DataGrid.Columns>
                <DataGridTextColumn Header="@Col.Name" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="@Col.Version" Binding="{Binding Version}" Width="96"/>
                <DataGridTextColumn Header="@Col.MinIos" Binding="{Binding MinIos}" Width="80"/>
                <DataGridTemplateColumn Header="@Col.Sign" Width="150">
                  <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding SignText}" ToolTip="{Binding SignText}"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="@Col.Size" Binding="{Binding SizeText}" SortMemberPath="SizeBytes" Width="84"/>
              </DataGrid.Columns>
            </DataGrid>
          </Border>
          <Grid Grid.Row="4" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
              <ProgressBar x:Name="DevProgress" Maximum="100" Height="4" Visibility="Collapsed"/>
              <TextBlock x:Name="DevProgressText" Style="{StaticResource Muted}" Margin="0,4,0,0"/>
            </StackPanel>
            <Button x:Name="DevCancelBtn" Grid.Column="1" x:Uid="Common.Cancel" Margin="0,0,8,0" IsEnabled="False"/>
            <Button x:Name="DevInstallBtn" Grid.Column="2" Style="{StaticResource PrimaryButton}">
              <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8EA;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{DynamicResource Brush.AccentText}" VerticalAlignment="Center"/><TextBlock x:Uid="Devices.Install" Margin="8,0,0,0" Foreground="{DynamicResource Brush.AccentText}"/></StackPanel>
            </Button>
          </Grid>
        </Grid>

        <!-- ===== Apple ID ===== -->
        <ScrollViewer x:Name="PageAccounts" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
          <Grid MaxWidth="980" HorizontalAlignment="Left">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="12"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
              <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                  <TextBlock x:Uid="Accounts.Current" Style="{StaticResource CardTitle}"/>
                  <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="AccStatusDot" Width="8" Height="8" Fill="{DynamicResource Brush.Warning}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="AccEmail" Style="{StaticResource BigValue}" FontSize="16" Margin="10,0,0,0" MaxWidth="360"/>
                  </StackPanel>
                  <TextBlock x:Name="AccDetail" Style="{StaticResource Muted}" Margin="18,4,0,12" TextWrapping="Wrap" TextTrimming="None"/>
                  <WrapPanel>
                    <Button x:Name="AccCheckBtn" x:Uid="Accounts.Check" Margin="0,0,8,0"/>
