                <Button x:Name="AccConsoleLoginBtn" Style="{StaticResource LinkButton}" Margin="0,14,0,0">
                  <TextBlock x:Uid="Accounts.ConsoleLogin" Foreground="{DynamicResource Brush.Accent}"/>
                </Button>
                <Border Background="{DynamicResource Brush.Surface2}" CornerRadius="4" Padding="10,8" Margin="0,14,0,0">
                  <TextBlock x:Uid="Accounts.SecurityNote" Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" TextTrimming="None"/>
                </Border>
              </StackPanel>
            </Border>
          </Grid>
