                <DataGridTextColumn Header="@Col.File" Binding="{Binding C4}" Width="*"/>
                <DataGridTemplateColumn Header="@Col.Result" Width="100">
                  <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding C5}" Style="{StaticResource StatusText}" ToolTip="{Binding Detail}"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
              </DataGrid.Columns>
            </DataGrid>
