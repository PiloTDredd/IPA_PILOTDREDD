                    <Grid x:Name="LibDGrid">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                      </Grid.ColumnDefinitions>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="22"/><RowDefinition Height="22"/><RowDefinition Height="22"/><RowDefinition Height="22"/>
                        <RowDefinition Height="22"/><RowDefinition Height="22"/><RowDefinition Height="22"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                      </Grid.RowDefinitions>
                      <TextBlock Grid.Row="0" x:Uid="Col.Version" Style="{StaticResource Muted}"/>
                      <TextBlock Grid.Row="0" Grid.Column="1" x:Name="LibDVersion"/>
                      <TextBlock Grid.Row="1" x:Uid="Library.Build" Style="{StaticResource Muted}"/>
                      <TextBlock Grid.Row="1" Grid.Column="1" x:Name="LibDBuild"/>
                      <TextBlock Grid.Row="2" x:Uid="Col.MinIos" Style="{StaticResource Muted}"/>
                      <TextBlock Grid.Row="2" Grid.Column="1" x:Name="LibDMinIos"/>
                      <TextBlock Grid.Row="3" x:Uid="Col.AppId" Style="{StaticResource Muted}"/>
                      <TextBlock Grid.Row="3" Grid.Column="1" x:Name="LibDAppId"/>
                      <TextBlock Grid.Row="4" x:Uid="Library.Artist" Style="{StaticResource Muted}"/>
                      <TextBlock Grid.Row="4" Grid.Column="1" x:Name="LibDArtist"/>
                      <TextBlock Grid.Row="5" x:Uid="Col.Size" Style="{StaticResource Muted}"/>
                      <TextBlock Grid.Row="5" Grid.Column="1" x:Name="LibDSize"/>
                      <TextBlock Grid.Row="6" x:Uid="Col.Date" Style="{StaticResource Muted}"/>
                      <TextBlock Grid.Row="6" Grid.Column="1" x:Name="LibDDate"/>
                      <TextBlock Grid.Row="7" x:Uid="Col.Sign" Style="{StaticResource Muted}" Margin="0,4,0,0"/>
                      <TextBlock Grid.Row="7" Grid.Column="1" x:Name="LibDSign" TextWrapping="Wrap" TextTrimming="None" Margin="0,4,0,0"/>
                      <TextBlock Grid.Row="8" Grid.ColumnSpan="2" x:Name="LibDFile" Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" TextTrimming="None" Margin="0,10,0,0"/>
                    </Grid>
                  </StackPanel>
                </ScrollViewer>
              </DockPanel>
            </Border>
          </Grid>
