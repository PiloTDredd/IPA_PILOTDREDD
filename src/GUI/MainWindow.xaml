                  <TextBlock x:Name="LibEmptyText" Style="{StaticResource Muted}" TextWrapping="Wrap" TextAlignment="Center" TextTrimming="None" Margin="0,10,0,0"/>
                  <ProgressBar x:Name="LibBusy" IsIndeterminate="True" Width="200" Height="3" Margin="0,12,0,0" Visibility="Collapsed"/>
