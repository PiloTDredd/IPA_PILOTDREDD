                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" VerticalAlignment="Center"/><TextBlock x:Uid="Devices.Scan" Margin="8,0,0,0"/></StackPanel>
              </Button>
