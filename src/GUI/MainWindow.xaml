<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="IPA PILOTDREDD" Width="1240" Height="800" MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource Brush.Bg}" Foreground="{DynamicResource Brush.Text}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" AllowDrop="True">
  <Window.Resources>
    <Style x:Key="StatusText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Style.Triggers>
        <DataTrigger Binding="{Binding Status}" Value="Done"><Setter Property="Foreground" Value="{DynamicResource Brush.Success}"/></DataTrigger>
        <DataTrigger Binding="{Binding Status}" Value="OK"><Setter Property="Foreground" Value="{DynamicResource Brush.Success}"/></DataTrigger>
        <DataTrigger Binding="{Binding Status}" Value="Ready"><Setter Property="Foreground" Value="{DynamicResource Brush.Success}"/></DataTrigger>
        <DataTrigger Binding="{Binding Status}" Value="Success"><Setter Property="Foreground" Value="{DynamicResource Brush.Success}"/></DataTrigger>
        <DataTrigger Binding="{Binding Status}" Value="Downloaded"><Setter Property="Foreground" Value="{DynamicResource Brush.Success}"/></DataTrigger>
        <DataTrigger Binding="{Binding Status}" Value="UpdateAvailable"><Setter Property="Foreground" Value="{DynamicResource Brush.Accent}"/></DataTrigger>
        <DataTrigger Binding="{Binding Status}" Value="Error"><Setter Property="Foreground" Value="{DynamicResource Brush.Danger}"/></DataTrigger>
        <DataTrigger Binding="{Binding Status}" Value="Failed"><Setter Property="Foreground" Value="{DynamicResource Brush.Danger}"/></DataTrigger>
        <DataTrigger Binding="{Binding Status}" Value="Warning"><Setter Property="Foreground" Value="{DynamicResource Brush.Warning}"/></DataTrigger>
        <DataTrigger Binding="{Binding Status}" Value="NotInStore"><Setter Property="Foreground" Value="{DynamicResource Brush.Warning}"/></DataTrigger>
        <DataTrigger Binding="{Binding Status}" Value="NotTrusted"><Setter Property="Foreground" Value="{DynamicResource Brush.Warning}"/></DataTrigger>
        <DataTrigger Binding="{Binding Status}" Value="Cancelled"><Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}"/></DataTrigger>
        <DataTrigger Binding="{Binding Status}" Value="Unverified"><Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}"/></DataTrigger>
        <DataTrigger Binding="{Binding Status}" Value="Running"><Setter Property="Foreground" Value="{DynamicResource Brush.Accent}"/></DataTrigger>
        <DataTrigger Binding="{Binding Status}" Value="Queued"><Setter Property="Foreground" Value="{DynamicResource Brush.Accent}"/></DataTrigger>
        <DataTrigger Binding="{Binding Status}" Value="InstallQueued"><Setter Property="Foreground" Value="{DynamicResource Brush.Accent}"/></DataTrigger>
        <DataTrigger Binding="{Binding Status}" Value="Installing"><Setter Property="Foreground" Value="{DynamicResource Brush.Accent}"/></DataTrigger>
        <DataTrigger Binding="{Binding Status}" Value="Installed"><Setter Property="Foreground" Value="{DynamicResource Brush.Success}"/></DataTrigger>
        <DataTrigger Binding="{Binding Status}" Value="InstallError"><Setter Property="Foreground" Value="{DynamicResource Brush.Danger}"/></DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="EmptyTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="TextAlignment" Value="Center"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="TextTrimming" Value="None"/>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="212"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- ================= Боковая панель ================= -->
    <Border Grid.Column="0" Background="{DynamicResource Brush.Sidebar}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,1,0">
      <DockPanel LastChildFill="False">
        <StackPanel DockPanel.Dock="Top" Margin="18,18,12,16" Orientation="Horizontal">
          <Border Width="28" Height="28" CornerRadius="6" Background="{DynamicResource Brush.Accent}">
            <TextBlock Text="&#xE896;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource Brush.AccentText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="IPA PILOTDREDD" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="15" FontWeight="SemiBold"/>
            <TextBlock x:Name="AppVersionText" Style="{StaticResource Muted}" FontSize="11"/>
          </StackPanel>
        </StackPanel>

        <StackPanel DockPanel.Dock="Top">
          <RadioButton x:Name="NavPurchases" x:Uid="Nav.Purchases" Style="{StaticResource NavButton}" Tag="&#xE719;" IsChecked="True"/>
          <RadioButton x:Name="NavCatalog" x:Uid="Nav.Catalog" Style="{StaticResource NavButton}" Tag="&#xE721;"/>
          <RadioButton x:Name="NavDownloads" x:Uid="Nav.Downloads" Style="{StaticResource NavButton}" Tag="&#xE896;"/>
          <RadioButton x:Name="NavLibrary" x:Uid="Nav.Library" Style="{StaticResource NavButton}" Tag="&#xE8B7;"/>
          <RadioButton x:Name="NavDevices" x:Uid="Nav.Devices" Style="{StaticResource NavButton}" Tag="&#xE8EA;"/>
          <Border Height="1" Background="{DynamicResource Brush.Border}" Margin="18,10"/>
          <RadioButton x:Name="NavAccounts" x:Uid="Nav.Accounts" Style="{StaticResource NavButton}" Tag="&#xE77B;"/>
          <RadioButton x:Name="NavSettings" x:Uid="Nav.Settings" Style="{StaticResource NavButton}" Tag="&#xE713;"/>
          <RadioButton x:Name="NavDiagnostics" x:Uid="Nav.Diagnostics" Style="{StaticResource NavButton}" Tag="&#xE9D9;"/>
        </StackPanel>

        <!-- Аккаунт: по клику — страница Apple ID -->
        <Button x:Name="SideAccountBtn" DockPanel.Dock="Bottom" Margin="8,0,8,10" Style="{StaticResource GhostButton}" HorizontalContentAlignment="Stretch" Padding="10,8" ToolTip="@Nav.Accounts">
          <Grid Width="172">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Ellipse x:Name="SideAccountDot" Width="8" Height="8" Fill="{DynamicResource Brush.Warning}" VerticalAlignment="Top" Margin="0,5,10,0"/>
            <StackPanel Grid.Column="1">
              <TextBlock x:Name="SideAccountText" FontSize="12" HorizontalAlignment="Left"/>
              <TextBlock x:Name="SideAccountDetail" Style="{StaticResource Muted}" FontSize="11" HorizontalAlignment="Left" Margin="0,1,0,0"/>
            </StackPanel>
          </Grid>
        </Button>
      </DockPanel>
    </Border>

    <!-- ================= Основная область ================= -->
    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- Заголовок страницы -->
      <Grid Grid.Row="0" Margin="24,16,24,12">
        <StackPanel>
          <TextBlock x:Name="PageTitle" Style="{StaticResource H1}"/>
          <TextBlock x:Name="PageSubtitle" Style="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0"/>
        </StackPanel>
        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
          <TextBlock x:Name="GlobalBusyText" Style="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" MaxWidth="360" Margin="0,0,10,0"/>
          <ProgressBar x:Name="GlobalBusy" Width="96" Height="3" IsIndeterminate="True" Visibility="Collapsed"/>
        </StackPanel>
      </Grid>

      <!-- Сообщение автора списков (Files/Warning.txt) -->
      <Border x:Name="WarningBanner" Grid.Row="1" Background="{DynamicResource Brush.WarningSoft}" BorderBrush="{DynamicResource Brush.Warning}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="24,0,24,12" Visibility="Collapsed">
        <DockPanel>
          <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" Foreground="{DynamicResource Brush.Warning}" Margin="0,0,10,0" DockPanel.Dock="Left"/>
          <Button x:Name="WarningClose" DockPanel.Dock="Right" Style="{StaticResource GhostButton}" ToolTip="@Common.Close" Margin="8,0,0,0">
            <TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10"/>
          </Button>
          <TextBlock x:Name="WarningText" TextWrapping="Wrap" TextTrimming="None" VerticalAlignment="Center"/>
        </DockPanel>
      </Border>

      <!-- ================= Страницы ================= -->
      <Grid Grid.Row="2" Margin="24,0,24,12">

        <!-- ===== Покупки ===== -->
        <Grid x:Name="PagePurchases">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" MaxWidth="460"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="PurSearch" Tag="@Purchases.Placeholder"/>
            <TextBlock x:Name="PurScanInfo" Grid.Column="1" Style="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="12,0,12,0"/>
            <Button x:Name="PurCancelBtn" Grid.Column="2" x:Uid="Common.Cancel" Margin="0,0,8,0" Visibility="Collapsed"/>
            <Button x:Name="PurScanBtn" Grid.Column="3" Style="{StaticResource PrimaryButton}" ToolTip="@Purchases.ScanHint">
              <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{DynamicResource Brush.AccentText}" VerticalAlignment="Center"/><TextBlock x:Uid="Purchases.Scan" Margin="8,0,0,0" Foreground="{DynamicResource Brush.AccentText}"/></StackPanel>
            </Button>
          </Grid>
          <WrapPanel Grid.Row="1" Margin="2,0,0,6">
            <RadioButton x:Name="PurTabAll" Style="{StaticResource FilterTab}" GroupName="PurTab" IsChecked="True"/>
            <RadioButton x:Name="PurTabAvailable" Style="{StaticResource FilterTab}" GroupName="PurTab"/>
            <RadioButton x:Name="PurTabDownloaded" Style="{StaticResource FilterTab}" GroupName="PurTab"/>
            <RadioButton x:Name="PurTabUpdates" Style="{StaticResource FilterTab}" GroupName="PurTab"/>
            <RadioButton x:Name="PurTabMissing" Style="{StaticResource FilterTab}" GroupName="PurTab"/>
            <RadioButton x:Name="PurTabProblems" Style="{StaticResource FilterTab}" GroupName="PurTab"/>
          </WrapPanel>
          <Border Grid.Row="2" Style="{StaticResource Card}" Padding="4">
            <Grid>
              <DataGrid x:Name="PurGrid" SelectionMode="Extended" RowHeight="48" CanUserSortColumns="True">
                <DataGrid.ContextMenu>
                  <ContextMenu x:Name="PurMenu">
                    <MenuItem x:Name="PurMenuDownload" x:Uid="Purchases.Download" InputGestureText="Enter"/>
                    <MenuItem x:Name="PurMenuInstall" Header="—"/>
                    <MenuItem x:Name="PurMenuVersion" x:Uid="Catalog.ChooseVersion"/>
                    <MenuItem x:Name="PurMenuShow" x:Uid="Common.ShowInFolder"/>
                    <Separator/>
                    <MenuItem x:Name="PurMenuStore" x:Uid="Purchases.OpenStore"/>
                    <MenuItem x:Name="PurMenuCopyId" x:Uid="Catalog.CopyId" InputGestureText="Ctrl+C"/>
                  </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                  <DataGridTemplateColumn Header="@Col.App" Width="*" SortMemberPath="Name">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <DockPanel VerticalAlignment="Center">
                          <Grid Width="32" Height="32" Margin="0,0,12,0" DockPanel.Dock="Left">
                            <Border CornerRadius="7" Background="{DynamicResource Brush.Surface2}">
                              <TextBlock Text="{Binding Initial}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border CornerRadius="7" Visibility="{Binding HasIcon, Converter={StaticResource BoolToVis}}">
                              <Border.Background><ImageBrush ImageSource="{Binding Icon}" Stretch="UniformToFill"/></Border.Background>
                            </Border>
                          </Grid>
                          <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" ToolTip="{Binding Name}"/>
                            <TextBlock Text="{Binding Artist}" Style="{StaticResource Muted}" FontSize="12" Margin="0,1,0,0"/>
                          </StackPanel>
                        </DockPanel>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn Header="@Col.Version" Binding="{Binding VersionText}" Width="110"/>
                  <DataGridTextColumn Header="@Col.PurchaseDate" Binding="{Binding PurchaseDateText}" SortMemberPath="SortDate" Width="100"/>
                  <DataGridTextColumn Header="@Col.Size" Binding="{Binding SizeText}" SortMemberPath="SizeBytes" Width="84"/>
                  <DataGridTemplateColumn Header="@Col.Status" Width="190" SortMemberPath="StatusOrder">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                          <TextBlock Text="{Binding StatusText}" Style="{StaticResource StatusText}" ToolTip="{Binding StatusDetail}"/>
                          <ProgressBar Value="{Binding Progress}" IsIndeterminate="{Binding IsIndeterminate}" Maximum="100" Height="3" Margin="0,5,0,0"
                                       Visibility="{Binding ShowProgress, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTemplateColumn Width="132" CanUserSort="False">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <Button Style="{StaticResource RowButton}" Content="{Binding ActionText}" IsEnabled="{Binding ActionEnabled}" Tag="{Binding}" HorizontalAlignment="Left" Focusable="False"/>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                </DataGrid.Columns>
              </DataGrid>
              <StackPanel x:Name="PurEmptyPanel" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460" Margin="0,0,0,24">
                <TextBlock x:Name="PurEmptyIcon" Text="&#xE719;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="28" Foreground="{DynamicResource Brush.TextMuted}" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                <TextBlock x:Name="PurEmptyTitle" Style="{StaticResource EmptyTitle}"/>
                <TextBlock x:Name="PurEmptyText" Style="{StaticResource Muted}" TextWrapping="Wrap" TextTrimming="None" TextAlignment="Center" Margin="0,6,0,0"/>
                <ProgressBar x:Name="PurBusy" IsIndeterminate="True" Width="220" Height="3" Margin="0,14,0,0" Visibility="Collapsed"/>
                <Button x:Name="PurEmptyBtn" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center" Margin="0,14,0,0" MinWidth="160"/>
              </StackPanel>
            </Grid>
          </Border>
          <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="PurSelText" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
              <Button x:Name="PurRetryBtn" x:Uid="Purchases.RetryFailed" Margin="0,0,8,0"/>
              <Button x:Name="PurShowFileBtn" x:Uid="Common.ShowInFolder" Margin="0,0,8,0"/>
              <Button x:Name="PurVersionBtn" x:Uid="Catalog.ChooseVersion" Margin="0,0,8,0"/>
              <Button x:Name="PurInstallBtn" Margin="0,0,8,0" ToolTip="@Purchases.InstallHint">
                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8EA;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" VerticalAlignment="Center"/><TextBlock x:Name="PurInstallText" Margin="8,0,0,0"/></StackPanel>
              </Button>
              <Button x:Name="PurDownloadBtn" Style="{StaticResource PrimaryButton}" MinWidth="150">
                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE896;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{DynamicResource Brush.AccentText}" VerticalAlignment="Center"/><TextBlock x:Name="PurDownloadText" Margin="8,0,0,0" Foreground="{DynamicResource Brush.AccentText}"/></StackPanel>
              </Button>
            </StackPanel>
          </Grid>
        </Grid>

        <!-- ===== Поиск ===== -->
        <Grid x:Name="PageCatalog" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="CatalogQuery" Tag="@Catalog.Placeholder"/>
            <Button x:Name="CatalogSearchBtn" Grid.Column="1" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0">
              <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{DynamicResource Brush.AccentText}" VerticalAlignment="Center"/><TextBlock x:Uid="Catalog.SearchStore" Margin="8,0,0,0" Foreground="{DynamicResource Brush.AccentText}"/></StackPanel>
            </Button>
            <Button x:Name="CatalogCancelBtn" Grid.Column="2" x:Uid="Common.Cancel" Margin="8,0,0,0" Visibility="Collapsed"/>
          </Grid>
          <WrapPanel Grid.Row="1" Margin="2,0,0,6">
            <RadioButton x:Name="SrcSearch" x:Uid="Catalog.SrcAll" Style="{StaticResource FilterTab}" GroupName="CatalogSrc" IsChecked="True"/>
            <RadioButton x:Name="SrcPopular" x:Uid="Catalog.SrcPopular" Style="{StaticResource FilterTab}" GroupName="CatalogSrc"/>
            <RadioButton x:Name="SrcCustom" x:Uid="Catalog.SrcCustom" Style="{StaticResource FilterTab}" GroupName="CatalogSrc"/>
          </WrapPanel>
          <Border Grid.Row="2" Style="{StaticResource Card}" Padding="4">
            <Grid>
              <DataGrid x:Name="CatalogGrid" SelectionMode="Extended" RowHeight="40">
                <DataGrid.ContextMenu>
                  <ContextMenu>
                    <MenuItem x:Name="CatMenuDownload" x:Uid="Catalog.Download" InputGestureText="Enter"/>
                    <MenuItem x:Name="CatMenuInstall" x:Uid="Purchases.DownloadInstall"/>
                    <MenuItem x:Name="CatMenuVersion" x:Uid="Catalog.ChooseVersion"/>
                    <MenuItem x:Name="CatMenuPurchase" x:Uid="Catalog.PurchaseOnly"/>
                    <Separator/>
                    <MenuItem x:Name="CatMenuAddCustom" x:Uid="Catalog.AddCustom"/>
                    <MenuItem x:Name="CatMenuCopyId" x:Uid="Catalog.CopyId" InputGestureText="Ctrl+C"/>
                  </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                  <DataGridTemplateColumn Header="@Col.Name" Width="*" SortMemberPath="Name">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <DockPanel VerticalAlignment="Center">
                          <Grid Width="26" Height="26" Margin="0,0,10,0" DockPanel.Dock="Left">
                            <Border CornerRadius="6" Background="{DynamicResource Brush.Surface2}">
                              <TextBlock Text="{Binding Initial}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border CornerRadius="6" Visibility="{Binding HasIcon, Converter={StaticResource BoolToVis}}">
                              <Border.Background><ImageBrush ImageSource="{Binding Icon}" Stretch="UniformToFill"/></Border.Background>
                            </Border>
                          </Grid>
                          <TextBlock Text="{Binding Name}" VerticalAlignment="Center" ToolTip="{Binding Name}"/>
                        </DockPanel>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn Header="@Col.AppId" Binding="{Binding Id}" Width="116"/>
                  <DataGridTextColumn Header="@Col.Version" Binding="{Binding Version}" Width="96"/>
                  <DataGridTextColumn Header="@Col.Source" Binding="{Binding SourceText}" Width="116"/>
                  <DataGridTextColumn Header="@Col.Status" Binding="{Binding StatusText}" Width="170"/>
                </DataGrid.Columns>
              </DataGrid>
              <StackPanel x:Name="CatalogEmptyPanel" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460">
                <TextBlock x:Name="CatalogEmptyIcon" Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="28" Foreground="{DynamicResource Brush.TextMuted}" HorizontalAlignment="Center"/>
                <TextBlock x:Name="CatalogEmptyText" Style="{StaticResource Muted}" TextWrapping="Wrap" TextTrimming="None" TextAlignment="Center" Margin="0,10,0,0"/>
                <ProgressBar x:Name="CatalogBusy" IsIndeterminate="True" Width="200" Height="3" Margin="0,12,0,0" Visibility="Collapsed"/>
              </StackPanel>
            </Grid>
          </Border>
          <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock x:Name="CatalogCount" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,16,0"/>
              <CheckBox x:Name="CatalogAutoPurchase" x:Uid="Catalog.AutoPurchaseShort" ToolTip="@Common.AutoPurchase" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
              <Button x:Name="CatalogVersionBtn" x:Uid="Catalog.ChooseVersion" Margin="0,0,8,0"/>
              <Button x:Name="CatalogDownloadBtn" Style="{StaticResource PrimaryButton}">
                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE896;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{DynamicResource Brush.AccentText}" VerticalAlignment="Center"/><TextBlock x:Uid="Catalog.Download" Margin="8,0,0,0" Foreground="{DynamicResource Brush.AccentText}"/></StackPanel>
              </Button>
            </StackPanel>
          </Grid>
        </Grid>

        <!-- ===== Загрузки ===== -->
        <Grid x:Name="PageDownloads" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="200"/>
          </Grid.RowDefinitions>
          <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Uid="Downloads.Folder" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBox x:Name="DlFolder" Grid.Column="1" IsReadOnly="True"/>
            <Button x:Name="DlChangeFolderBtn" Grid.Column="2" x:Uid="Common.Change" Margin="8,0,0,0"/>
            <Button x:Name="DlOpenFolderBtn" Grid.Column="3" x:Uid="Common.Open" Margin="8,0,0,0"/>
          </Grid>
          <Border Grid.Row="1" Style="{StaticResource Card}" Padding="4">
            <Grid>
              <DataGrid x:Name="DlQueueGrid" SelectionMode="Extended" RowHeight="44">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="@Col.Name" Binding="{Binding AppName}" Width="*"/>
                  <DataGridTextColumn Header="@Col.Version" Binding="{Binding VersionText}" Width="100"/>
                  <DataGridTemplateColumn Header="@Col.Status" Width="130">
                    <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding StatusText}" Style="{StaticResource StatusText}" ToolTip="{Binding Error}"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTemplateColumn Header="@Col.Progress" Width="210">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <StackPanel VerticalAlignment="Center" Visibility="{Binding ShowProgress, Converter={StaticResource BoolToVis}}" Margin="0,0,10,0">
                          <ProgressBar Value="{Binding Progress}" IsIndeterminate="{Binding IsIndeterminate}" Maximum="100" Height="4"/>
                          <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Muted}" FontSize="11" Margin="0,3,0,0"/>
                        </StackPanel>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTemplateColumn Header="@Col.File" Width="*">
                    <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding FileName}" ToolTip="{Binding Error}"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                </DataGrid.Columns>
              </DataGrid>
              <TextBlock x:Name="DlQueueEmpty" x:Uid="Downloads.Empty" Style="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextTrimming="None" TextAlignment="Center" MaxWidth="420"/>
            </Grid>
          </Border>
          <Grid Grid.Row="2" Margin="0,10,0,14">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <CheckBox x:Name="DlAutoPurchase" x:Uid="Catalog.AutoPurchaseShort" ToolTip="@Common.AutoPurchase" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
              <Button x:Name="DlShowFileBtn" x:Uid="Common.ShowInFolder" Margin="0,0,8,0"/>
              <Button x:Name="DlClearBtn" x:Uid="Downloads.ClearDone" Margin="0,0,8,0"/>
              <Button x:Name="DlRetryBtn" x:Uid="Downloads.Retry" Margin="0,0,8,0"/>
              <Button x:Name="DlCancelBtn" x:Uid="Downloads.CancelSelected" Margin="0,0,8,0"/>
              <Button x:Name="DlCancelAllBtn" x:Uid="Downloads.CancelAll" Style="{StaticResource DangerButton}"/>
            </StackPanel>
          </Grid>
          <Grid Grid.Row="3" Margin="0,0,0,6">
            <TextBlock x:Uid="Downloads.History" Style="{StaticResource CardTitle}" VerticalAlignment="Center" Margin="0"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <Button x:Name="DlHistoryRemoveBtn" x:Uid="Downloads.HistoryRemove" Style="{StaticResource GhostButton}" ToolTip="Delete" Margin="0,0,4,0"/>
              <Button x:Name="DlHistoryClearBtn" x:Uid="Downloads.HistoryClear" Style="{StaticResource GhostButton}"/>
            </StackPanel>
          </Grid>
          <Border Grid.Row="4" Style="{StaticResource Card}" Padding="4">
            <DataGrid x:Name="DlHistoryGrid" SelectionMode="Extended">
              <DataGrid.Columns>
                <DataGridTextColumn Header="@Col.Date" Binding="{Binding C1}" Width="150"/>
                <DataGridTextColumn Header="@Col.Operation" Binding="{Binding C6}" Width="100"/>
                <DataGridTextColumn Header="@Col.Name" Binding="{Binding C2}" Width="*"/>
                <DataGridTextColumn Header="@Col.Version" Binding="{Binding C3}" Width="100"/>
                <DataGridTextColumn Header="@Col.File" Binding="{Binding C4}" Width="*"/>
                <DataGridTemplateColumn Header="@Col.Result" Width="100">
                  <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding C5}" Style="{StaticResource StatusText}" ToolTip="{Binding Detail}"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
              </DataGrid.Columns>
            </DataGrid>
          </Border>
        </Grid>

        <!-- ===== Файлы IPA ===== -->
        <Grid x:Name="PageLibrary" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" MaxWidth="460"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="LibSearch" Tag="@Library.Placeholder"/>
            <TextBlock x:Name="LibCount" Grid.Column="1" Style="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="12,0,12,0"/>
            <Button x:Name="LibRefreshBtn" Grid.Column="2" x:Uid="Common.Refresh" Margin="0,0,8,0"/>
            <Button x:Name="LibOpenFolderBtn" Grid.Column="3" x:Uid="Common.OpenFolder" Margin="0,0,8,0"/>
            <Button x:Name="LibAddBtn" Grid.Column="4" Style="{StaticResource PrimaryButton}" ToolTip="@Library.AddHint">
              <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{DynamicResource Brush.AccentText}" VerticalAlignment="Center"/><TextBlock x:Uid="Library.AddIpa" Margin="8,0,0,0" Foreground="{DynamicResource Brush.AccentText}"/></StackPanel>
            </Button>
          </Grid>
          <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="12"/>
              <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Padding="4">
              <Grid>
                <DataGrid x:Name="LibGrid" SelectionMode="Extended">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="@Col.Name" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="@Col.Version" Binding="{Binding Version}" Width="90"/>
                    <DataGridTextColumn Header="@Col.MinIos" Binding="{Binding MinIos}" Width="70"/>
                    <DataGridTemplateColumn Header="@Col.Sign" Width="150">
                      <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding SignText}" ToolTip="{Binding SignText}"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="@Col.Size" Binding="{Binding SizeText}" SortMemberPath="SizeBytes" Width="84"/>
                    <DataGridTextColumn Header="@Col.Date" Binding="{Binding DateText}" SortMemberPath="Date" Width="124"/>
                  </DataGrid.Columns>
                </DataGrid>
                <StackPanel x:Name="LibEmptyPanel" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="400">
                  <TextBlock Text="&#xE8B7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="28" Foreground="{DynamicResource Brush.TextMuted}" HorizontalAlignment="Center"/>
                  <TextBlock x:Name="LibEmptyText" Style="{StaticResource Muted}" TextWrapping="Wrap" TextAlignment="Center" TextTrimming="None" Margin="0,10,0,0"/>
                  <ProgressBar x:Name="LibBusy" IsIndeterminate="True" Width="200" Height="3" Margin="0,12,0,0" Visibility="Collapsed"/>
                </StackPanel>
              </Grid>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}">
              <DockPanel>
                <StackPanel DockPanel.Dock="Bottom">
                  <Button x:Name="LibInstallBtn" Style="{StaticResource PrimaryButton}" Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8EA;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{DynamicResource Brush.AccentText}" VerticalAlignment="Center"/><TextBlock x:Uid="Library.Install" Margin="8,0,0,0" Foreground="{DynamicResource Brush.AccentText}"/></StackPanel>
                  </Button>
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Button x:Name="LibShowBtn" x:Uid="Common.ShowInFolder"/>
                    <Button x:Name="LibDeleteBtn" Grid.Column="2" x:Uid="Library.Delete" Style="{StaticResource DangerButton}"/>
                  </Grid>
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                  <StackPanel x:Name="LibDetailPanel">
                    <TextBlock x:Name="LibDName" Style="{StaticResource BigValue}" FontSize="16" TextWrapping="Wrap" TextTrimming="None"/>
                    <TextBlock x:Name="LibDBundle" Style="{StaticResource Muted}" FontSize="12" Margin="0,3,0,12" TextWrapping="Wrap" TextTrimming="None"/>
                    <Grid x:Name="LibDGrid">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                      </Grid.ColumnDefinitions>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="22"/><RowDefinition Height="22"/><RowDefinition Height="22"/><RowDefinition Height="22"/>
                        <RowDefinition Height="22"/><RowDefinition Height="22"/><RowDefinition Height="22"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                      </Grid.RowDefinitions>
                      <TextBlock Grid.Row="0" x:Uid="Col.Version" Style="{StaticResource Muted}"/>
                      <TextBlock Grid.Row="0" Grid.Column="1" x:Name="LibDVersion"/>
                      <TextBlock Grid.Row="1" x:Uid="Library.Build" Style="{StaticResource Muted}"/>
                      <TextBlock Grid.Row="1" Grid.Column="1" x:Name="LibDBuild"/>
                      <TextBlock Grid.Row="2" x:Uid="Col.MinIos" Style="{StaticResource Muted}"/>
                      <TextBlock Grid.Row="2" Grid.Column="1" x:Name="LibDMinIos"/>
                      <TextBlock Grid.Row="3" x:Uid="Col.AppId" Style="{StaticResource Muted}"/>
                      <TextBlock Grid.Row="3" Grid.Column="1" x:Name="LibDAppId"/>
                      <TextBlock Grid.Row="4" x:Uid="Library.Artist" Style="{StaticResource Muted}"/>
                      <TextBlock Grid.Row="4" Grid.Column="1" x:Name="LibDArtist"/>
                      <TextBlock Grid.Row="5" x:Uid="Col.Size" Style="{StaticResource Muted}"/>
                      <TextBlock Grid.Row="5" Grid.Column="1" x:Name="LibDSize"/>
                      <TextBlock Grid.Row="6" x:Uid="Col.Date" Style="{StaticResource Muted}"/>
                      <TextBlock Grid.Row="6" Grid.Column="1" x:Name="LibDDate"/>
                      <TextBlock Grid.Row="7" x:Uid="Col.Sign" Style="{StaticResource Muted}" Margin="0,4,0,0"/>
                      <TextBlock Grid.Row="7" Grid.Column="1" x:Name="LibDSign" TextWrapping="Wrap" TextTrimming="None" Margin="0,4,0,0"/>
                      <TextBlock Grid.Row="8" Grid.ColumnSpan="2" x:Name="LibDFile" Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" TextTrimming="None" Margin="0,10,0,0"/>
                    </Grid>
                  </StackPanel>
                </ScrollViewer>
              </DockPanel>
            </Border>
          </Grid>
        </Grid>

        <!-- ===== Устройства ===== -->
        <Grid x:Name="PageDevices" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="170"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <Grid Margin="0,0,0,8">
            <TextBlock x:Uid="Dash.Devices" Style="{StaticResource CardTitle}" VerticalAlignment="Center" Margin="0"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <TextBlock x:Name="DevStatusText" Style="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0"/>
              <Button x:Name="DevScanBtn">
                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" VerticalAlignment="Center"/><TextBlock x:Uid="Devices.Scan" Margin="8,0,0,0"/></StackPanel>
              </Button>
            </StackPanel>
          </Grid>
          <Border Grid.Row="1" Style="{StaticResource Card}" Padding="4">
            <Grid>
              <DataGrid x:Name="DevGrid" SelectionMode="Extended">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="@Col.DeviceName" Binding="{Binding Name}" Width="*"/>
                  <DataGridTextColumn Header="@Col.Model" Binding="{Binding Model}" Width="120"/>
                  <DataGridTextColumn Header="@Col.Ios" Binding="{Binding IosVersion}" Width="80"/>
                  <DataGridTextColumn Header="@Col.Udid" Binding="{Binding ShortUdid}" Width="160"/>
                  <DataGridTemplateColumn Header="@Col.Status" Width="160">
                    <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding StatusText}" Style="{StaticResource StatusText}" ToolTip="{Binding Detail}"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                </DataGrid.Columns>
              </DataGrid>
              <TextBlock x:Name="DevEmptyText" Style="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextTrimming="None" TextAlignment="Center" MaxWidth="520"/>
            </Grid>
          </Border>
          <Grid Grid.Row="2" Margin="0,14,0,8">
            <TextBlock x:Uid="Devices.ChooseIpa" Style="{StaticResource CardTitle}" VerticalAlignment="Center" Margin="0"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <TextBlock x:Uid="Devices.DropHint" Style="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0"/>
              <Button x:Name="DevAddFileBtn" x:Uid="Devices.AddFile"/>
            </StackPanel>
          </Grid>
          <Border Grid.Row="3" Style="{StaticResource Card}" Padding="4">
            <DataGrid x:Name="DevIpaGrid" SelectionMode="Extended">
              <DataGrid.Columns>
                <DataGridTextColumn Header="@Col.Name" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="@Col.Version" Binding="{Binding Version}" Width="96"/>
                <DataGridTextColumn Header="@Col.MinIos" Binding="{Binding MinIos}" Width="80"/>
                <DataGridTemplateColumn Header="@Col.Sign" Width="150">
                  <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding SignText}" ToolTip="{Binding SignText}"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="@Col.Size" Binding="{Binding SizeText}" SortMemberPath="SizeBytes" Width="84"/>
              </DataGrid.Columns>
            </DataGrid>
          </Border>
          <Grid Grid.Row="4" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
              <ProgressBar x:Name="DevProgress" Maximum="100" Height="4" Visibility="Collapsed"/>
              <TextBlock x:Name="DevProgressText" Style="{StaticResource Muted}" Margin="0,4,0,0"/>
            </StackPanel>
            <Button x:Name="DevCancelBtn" Grid.Column="1" x:Uid="Common.Cancel" Margin="0,0,8,0" IsEnabled="False"/>
            <Button x:Name="DevInstallBtn" Grid.Column="2" Style="{StaticResource PrimaryButton}">
              <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8EA;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{DynamicResource Brush.AccentText}" VerticalAlignment="Center"/><TextBlock x:Uid="Devices.Install" Margin="8,0,0,0" Foreground="{DynamicResource Brush.AccentText}"/></StackPanel>
            </Button>
          </Grid>
        </Grid>

        <!-- ===== Apple ID ===== -->
        <ScrollViewer x:Name="PageAccounts" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
          <Grid MaxWidth="980" HorizontalAlignment="Left">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="12"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
              <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                  <TextBlock x:Uid="Accounts.Current" Style="{StaticResource CardTitle}"/>
                  <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="AccStatusDot" Width="8" Height="8" Fill="{DynamicResource Brush.Warning}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="AccEmail" Style="{StaticResource BigValue}" FontSize="16" Margin="10,0,0,0" MaxWidth="360"/>
                  </StackPanel>
                  <TextBlock x:Name="AccDetail" Style="{StaticResource Muted}" Margin="18,4,0,12" TextWrapping="Wrap" TextTrimming="None"/>
                  <WrapPanel>
                    <Button x:Name="AccCheckBtn" x:Uid="Accounts.Check" Margin="0,0,8,0"/>
                    <Button x:Name="AccLogoutBtn" x:Uid="Accounts.Logout" Style="{StaticResource DangerButton}"/>
                  </WrapPanel>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock x:Uid="Accounts.Saved" Style="{StaticResource CardTitle}"/>
                  <ListBox x:Name="AccSavedList" MinHeight="60" MaxHeight="220">
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <DockPanel>
                          <TextBlock DockPanel.Dock="Right" Text="{Binding C2}" Style="{StaticResource Muted}" Margin="16,0,0,0"/>
                          <TextBlock Text="{Binding C1}"/>
                        </DockPanel>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                  <TextBlock x:Name="AccSavedEmpty" x:Uid="Accounts.SavedEmpty" Style="{StaticResource Muted}" Margin="4,0,0,8"/>
                  <WrapPanel Margin="0,8,0,0">
                    <Button x:Name="AccSwitchBtn" x:Uid="Accounts.Switch" Margin="0,0,8,0"/>
                    <Button x:Name="AccForgetBtn" x:Uid="Accounts.Forget" Style="{StaticResource DangerButton}"/>
                  </WrapPanel>
                </StackPanel>
              </Border>
            </StackPanel>
            <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
              <StackPanel>
                <TextBlock x:Name="AccLoginTitle" x:Uid="Accounts.LoginTitle" Style="{StaticResource CardTitle}"/>
                <TextBlock x:Uid="Accounts.Email" Style="{StaticResource Muted}" Margin="0,4,0,4"/>
                <TextBox x:Name="AccLoginEmail" Tag="user@example.com"/>
                <TextBlock x:Uid="Accounts.Password" Style="{StaticResource Muted}" Margin="0,10,0,4"/>
                <PasswordBox x:Name="AccLoginPassword"/>
                <StackPanel x:Name="AccCodePanel" Visibility="Collapsed">
                  <TextBlock x:Uid="Accounts.Code" Style="{StaticResource Muted}" Margin="0,10,0,4"/>
                  <TextBox x:Name="AccLoginCode" Tag="123456" MaxLength="8"/>
                  <TextBlock x:Uid="Accounts.CodeHint" Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" TextTrimming="None" Margin="0,4,0,0"/>
                </StackPanel>
                <TextBlock x:Name="AccLoginError" Foreground="{DynamicResource Brush.Danger}" TextWrapping="Wrap" TextTrimming="None" Margin="0,10,0,0" Visibility="Collapsed"/>
                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                  <Button x:Name="AccLoginBtn" x:Uid="Accounts.LoginBtn" Style="{StaticResource PrimaryButton}" MinWidth="120"/>
                  <Button x:Name="AccLoginCancelBtn" x:Uid="Common.Cancel" Margin="8,0,0,0" Visibility="Collapsed"/>
                  <ProgressBar x:Name="AccLoginBusy" IsIndeterminate="True" Width="90" Height="3" Margin="12,0,0,0" Visibility="Collapsed"/>
                </StackPanel>
                <Button x:Name="AccConsoleLoginBtn" Style="{StaticResource LinkButton}" Margin="0,14,0,0">
                  <TextBlock x:Uid="Accounts.ConsoleLogin" Foreground="{DynamicResource Brush.Accent}"/>
                </Button>
                <Border Background="{DynamicResource Brush.Surface2}" CornerRadius="4" Padding="10,8" Margin="0,14,0,0">
                  <TextBlock x:Uid="Accounts.SecurityNote" Style="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" TextTrimming="None"/>
                </Border>
              </StackPanel>
            </Border>
          </Grid>
        </ScrollViewer>

        <!-- ===== Настройки ===== -->
        <ScrollViewer x:Name="PageSettings" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
          <StackPanel MaxWidth="820" HorizontalAlignment="Left">
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
              <StackPanel>
                <TextBlock x:Uid="Settings.Appearance" Style="{StaticResource CardTitle}"/>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                  <TextBlock x:Uid="Settings.Language" VerticalAlignment="Center"/>
                  <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <RadioButton x:Name="SetLangRu" Content="Русский" Style="{StaticResource Segment}" GroupName="Lang"/>
                    <RadioButton x:Name="SetLangEn" Content="English" Style="{StaticResource Segment}" GroupName="Lang"/>
                  </StackPanel>
                  <TextBlock Grid.Row="1" x:Uid="Settings.Theme" VerticalAlignment="Center" Margin="0,10,0,0"/>
                  <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,10,0,0">
                    <RadioButton x:Name="SetThemeDark" x:Uid="Settings.ThemeDark" Style="{StaticResource Segment}" GroupName="Theme"/>
                    <RadioButton x:Name="SetThemeLight" x:Uid="Settings.ThemeLight" Style="{StaticResource Segment}" GroupName="Theme"/>
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
              <StackPanel>
                <TextBlock x:Uid="Settings.Paths" Style="{StaticResource CardTitle}"/>
                <TextBlock x:Uid="Settings.DownloadFolder" Margin="0,0,0,4"/>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBox x:Name="SetDownloadFolder" IsReadOnly="True"/>
                  <Button x:Name="SetDownloadFolderBtn" Grid.Column="1" x:Uid="Common.Change" Margin="8,0,0,0"/>
                  <Button x:Name="SetDownloadFolderReset" Grid.Column="2" x:Uid="Common.Default" Margin="8,0,0,0"/>
                </Grid>
                <TextBlock x:Uid="Settings.BinaryRoot" Margin="0,14,0,4"/>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBox x:Name="SetBinaryRoot" IsReadOnly="True" Tag="@Settings.BinaryAuto"/>
                  <Button x:Name="SetBinaryRootBtn" Grid.Column="1" x:Uid="Common.Change" Margin="8,0,0,0"/>
                  <Button x:Name="SetBinaryRootReset" Grid.Column="2" x:Uid="Settings.Auto" Margin="8,0,0,0"/>
                </Grid>
                <TextBlock x:Name="SetBinaryInfo" Style="{StaticResource Muted}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap" TextTrimming="None"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
              <StackPanel>
                <TextBlock x:Uid="Settings.Behavior" Style="{StaticResource CardTitle}"/>
                <CheckBox x:Name="SetUpdateLists" x:Uid="Settings.UpdateLists" Margin="0,4"/>
                <CheckBox x:Name="SetCheckUpdates" x:Uid="Settings.CheckUpdates" Margin="0,4"/>
                <CheckBox x:Name="SetAutoPurchase" x:Uid="Common.AutoPurchase" Margin="0,4"/>
                <CheckBox x:Name="SetFileNameAccount" x:Uid="Settings.FileNameAccount" Margin="0,4"/>
                <TextBlock x:Uid="Settings.RemoteUrl" Margin="0,12,0,4"/>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBox x:Name="SetRemoteUrl"/>
                  <Button x:Name="SetRemoteUrlSave" Grid.Column="1" x:Uid="Common.Save" Margin="8,0,0,0"/>
                </Grid>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
              <StackPanel>
                <TextBlock x:Uid="Settings.Security" Style="{StaticResource CardTitle}"/>
                <CheckBox x:Name="SetKeychain" x:Uid="Settings.Keychain" Margin="0,4"/>
                <TextBlock x:Uid="Settings.KeychainNote" Style="{StaticResource Muted}" FontSize="11" Margin="27,0,0,8" TextWrapping="Wrap" TextTrimming="None"/>
                <CheckBox x:Name="SetDebug" x:Uid="Settings.Debug" Margin="0,4"/>
                <TextBlock x:Uid="Settings.DebugNote" Style="{StaticResource Muted}" FontSize="11" Margin="27,0,0,0" TextWrapping="Wrap" TextTrimming="None"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <!-- ===== Диагностика ===== -->
        <Grid x:Name="PageDiagnostics" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <WrapPanel Margin="0,0,0,8">
            <Button x:Name="DiagRefreshBtn" x:Uid="Diag.Refresh" Style="{StaticResource PrimaryButton}" Margin="0,0,8,6"/>
            <Button x:Name="DiagExportBtn" x:Uid="Diag.Export" Margin="0,0,8,6"/>
            <Button x:Name="DiagOpenLogsBtn" x:Uid="Diag.OpenLogs" Margin="0,0,8,6"/>
            <Button x:Name="DiagUpdateListsBtn" x:Uid="Diag.UpdateLists" Margin="0,0,8,6"/>
            <Button x:Name="DiagCheckUpdatesBtn" x:Uid="Diag.CheckUpdates" Margin="0,0,8,6"/>
          </WrapPanel>
          <Border Grid.Row="1" Style="{StaticResource Card}" Padding="4">
            <DataGrid x:Name="DiagGrid" RowHeight="38">
              <DataGrid.Columns>
                <DataGridTextColumn Header="@Col.Check" Binding="{Binding C1}" Width="230"/>
                <DataGridTemplateColumn Header="@Col.Status" Width="110">
                  <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding C2}" Style="{StaticResource StatusText}"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="@Col.Detail" Width="*">
                  <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding C3}" ToolTip="{Binding C3}"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="@Col.Hint" Width="*">
                  <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding C4}" ToolTip="{Binding C4}" Style="{StaticResource Muted}"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
              </DataGrid.Columns>
            </DataGrid>
          </Border>
          <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock x:Uid="Diag.System" Style="{StaticResource CardTitle}"/>
                <TextBlock x:Name="DiagSystem" Style="{StaticResource Muted}" TextWrapping="Wrap" TextTrimming="None" FontFamily="Consolas" FontSize="12"/>
              </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock x:Uid="Diag.About" Style="{StaticResource CardTitle}"/>
                <TextBlock x:Uid="Diag.AboutText" Style="{StaticResource Muted}" TextWrapping="Wrap" TextTrimming="None"/>
                <WrapPanel Margin="0,10,0,0">
                  <Button x:Name="DiagRepoLink" Style="{StaticResource LinkButton}" Margin="0,0,16,0"><TextBlock x:Uid="Diag.Upstream" Foreground="{DynamicResource Brush.Accent}"/></Button>
                  <Button x:Name="DiagTipLink" Style="{StaticResource LinkButton}" ToolTip="@Diag.TipJarHint"><TextBlock x:Uid="Diag.TipJar" Foreground="{DynamicResource Brush.Accent}"/></Button>
                </WrapPanel>
              </StackPanel>
            </Border>
          </Grid>
        </Grid>
      </Grid>

      <!-- Уведомление (проверка при запуске, обновления): не блокирует окно -->
      <Border x:Name="Toast" Grid.Row="2" Panel.ZIndex="10" Width="380" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,36,28"
              Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="6" Padding="14,12" Visibility="Collapsed">
        <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.28"/></Border.Effect>
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock x:Name="ToastIcon" Style="{StaticResource Icon}" FontSize="16" VerticalAlignment="Top" Margin="0,1,12,0"/>
          <StackPanel Grid.Column="1">
            <TextBlock x:Name="ToastTitle" FontWeight="SemiBold" TextWrapping="Wrap" TextTrimming="None"/>
            <TextBlock x:Name="ToastText" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" TextTrimming="None" Margin="0,3,0,0"/>
            <ProgressBar x:Name="ToastProgress" Height="3" Maximum="100" Margin="0,8,0,0" Visibility="Collapsed"/>
            <StackPanel x:Name="ToastButtons" Orientation="Horizontal" Margin="0,10,0,0">
              <Button x:Name="ToastAction" Style="{StaticResource PrimaryButton}" Padding="12,3" MinHeight="26" Margin="0,0,8,0"/>
              <Button x:Name="ToastLater" x:Uid="Update.Later" Padding="12,3" MinHeight="26"/>
            </StackPanel>
          </StackPanel>
          <Button x:Name="ToastClose" Grid.Column="2" Style="{StaticResource GhostButton}" VerticalAlignment="Top" Margin="8,-4,-6,0" ToolTip="@Common.Close">
            <TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10"/>
          </Button>
        </Grid>
      </Border>
      <!-- ================= Строка состояния и журнал ================= -->
      <Border Grid.Row="3" Background="{DynamicResource Brush.LogBg}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0">
        <DockPanel>
          <Grid DockPanel.Dock="Top" Margin="16,3,12,3" MinHeight="26">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ToggleButton x:Name="LogToggle" IsChecked="False" Cursor="Hand" Background="Transparent" BorderThickness="0" FocusVisualStyle="{x:Null}" ToolTip="Ctrl+L" VerticalAlignment="Center">
              <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                  <StackPanel Orientation="Horizontal" Background="Transparent">
                    <TextBlock x:Name="chev" Text="&#xE70E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="9" Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center"/>
                    <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
                  </StackPanel>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="chev" Property="Text" Value="&#xE70D;"/></Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </ToggleButton.Template>
              <TextBlock x:Uid="Log.Title" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}"/>
            </ToggleButton>
            <TextBlock x:Name="LogLastLine" Grid.Column="1" Style="{StaticResource Muted}" Margin="14,0,12,0" VerticalAlignment="Center" FontSize="12"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Visibility="{Binding IsChecked, ElementName=LogToggle, Converter={StaticResource BoolToVis}}" Margin="0,0,12,0">
              <CheckBox x:Name="LogErrorsOnly" x:Uid="Log.ErrorsOnly" VerticalAlignment="Center" FontSize="12" Margin="0,0,8,0"/>
              <Button x:Name="LogCopyBtn" x:Uid="Log.Copy" Style="{StaticResource GhostButton}"/>
              <Button x:Name="LogClearBtn" x:Uid="Log.Clear" Style="{StaticResource GhostButton}"/>
              <Button x:Name="LogOpenBtn" x:Uid="Log.OpenFile" Style="{StaticResource GhostButton}"/>
            </StackPanel>
            <TextBlock x:Name="StatusRight" Grid.Column="3" Style="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center"/>
          </Grid>
          <TextBox x:Name="LogBox" Style="{StaticResource LogBox}" Height="160" Margin="16,0,8,8" Visibility="{Binding IsChecked, ElementName=LogToggle, Converter={StaticResource BoolToVis}}"/>
        </DockPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
