                  <Button x:Name="DiagTipLink" Style="{StaticResource LinkButton}" ToolTip="@Diag.TipJarHint"><TextBlock x:Uid="Diag.TipJar" Foreground="{DynamicResource Brush.Accent}"/></Button>
