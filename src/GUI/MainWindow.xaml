                    <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding StatusText}" Style="{StaticResource StatusText}" ToolTip="{Binding Detail}"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                </DataGrid.Columns>
              </DataGrid>
              <TextBlock x:Name="DevEmptyText" Style="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextTrimming="None" TextAlignment="Center" MaxWidth="520"/>
            </Grid>
          </Border>
          <Grid Grid.Row="2" Margin="0,14,0,8">
            <TextBlock x:Uid="Devices.ChooseIpa" Style="{StaticResource CardTitle}" VerticalAlignment="Center" Margin="0"/>
