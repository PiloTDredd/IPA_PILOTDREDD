                  <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                  <TextBlock x:Uid="Settings.Language" VerticalAlignment="Center"/>
                  <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <RadioButton x:Name="SetLangRu" Content="Русский" Style="{StaticResource Segment}" GroupName="Lang"/>
                    <RadioButton x:Name="SetLangEn" Content="English" Style="{StaticResource Segment}" GroupName="Lang"/>
                  </StackPanel>
                  <TextBlock Grid.Row="1" x:Uid="Settings.Theme" VerticalAlignment="Center" Margin="0,10,0,0"/>
                  <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,10,0,0">
                    <RadioButton x:Name="SetThemeDark" x:Uid="Settings.ThemeDark" Style="{StaticResource Segment}" GroupName="Theme"/>
                    <RadioButton x:Name="SetThemeLight" x:Uid="Settings.ThemeLight" Style="{StaticResource Segment}" GroupName="Theme"/>
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
              <StackPanel>
                <TextBlock x:Uid="Settings.Paths" Style="{StaticResource CardTitle}"/>
                <TextBlock x:Uid="Settings.DownloadFolder" Margin="0,0,0,4"/>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBox x:Name="SetDownloadFolder" IsReadOnly="True"/>
                  <Button x:Name="SetDownloadFolderBtn" Grid.Column="1" x:Uid="Common.Change" Margin="8,0,0,0"/>
                  <Button x:Name="SetDownloadFolderReset" Grid.Column="2" x:Uid="Common.Default" Margin="8,0,0,0"/>
                </Grid>
                <TextBlock x:Uid="Settings.BinaryRoot" Margin="0,14,0,4"/>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBox x:Name="SetBinaryRoot" IsReadOnly="True" Tag="@Settings.BinaryAuto"/>
                  <Button x:Name="SetBinaryRootBtn" Grid.Column="1" x:Uid="Common.Change" Margin="8,0,0,0"/>
                  <Button x:Name="SetBinaryRootReset" Grid.Column="2" x:Uid="Settings.Auto" Margin="8,0,0,0"/>
                </Grid>
                <TextBlock x:Name="SetBinaryInfo" Style="{StaticResource Muted}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap" TextTrimming="None"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
              <StackPanel>
                <TextBlock x:Uid="Settings.Behavior" Style="{StaticResource CardTitle}"/>
                <CheckBox x:Name="SetUpdateLists" x:Uid="Settings.UpdateLists" Margin="0,4"/>
                <CheckBox x:Name="SetCheckUpdates" x:Uid="Settings.CheckUpdates" Margin="0,4"/>
                <CheckBox x:Name="SetAutoPurchase" x:Uid="Common.AutoPurchase" Margin="0,4"/>
                <CheckBox x:Name="SetFileNameAccount" x:Uid="Settings.FileNameAccount" Margin="0,4"/>
                <TextBlock x:Uid="Settings.RemoteUrl" Margin="0,12,0,4"/>
