                  </WrapPanel>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock x:Uid="Accounts.Saved" Style="{StaticResource CardTitle}"/>
                  <ListBox x:Name="AccSavedList" MinHeight="60" MaxHeight="220">
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <DockPanel>
                          <TextBlock DockPanel.Dock="Right" Text="{Binding C2}" Style="{StaticResource Muted}" Margin="16,0,0,0"/>
                          <TextBlock Text="{Binding C1}"/>
                        </DockPanel>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                  <TextBlock x:Name="AccSavedEmpty" x:Uid="Accounts.SavedEmpty" Style="{StaticResource Muted}" Margin="4,0,0,8"/>
                  <WrapPanel Margin="0,8,0,0">
                    <Button x:Name="AccSwitchBtn" x:Uid="Accounts.Switch" Margin="0,0,8,0"/>
                    <Button x:Name="AccForgetBtn" x:Uid="Accounts.Forget" Style="{StaticResource DangerButton}"/>
                  </WrapPanel>
                </StackPanel>
              </Border>
            </StackPanel>
            <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
              <StackPanel>
                <TextBlock x:Name="AccLoginTitle" x:Uid="Accounts.LoginTitle" Style="{StaticResource CardTitle}"/>
                <TextBlock x:Uid="Accounts.Email" Style="{StaticResource Muted}" Margin="0,4,0,4"/>
                <TextBox x:Name="AccLoginEmail" Tag="user@example.com"/>
                <TextBlock x:Uid="Accounts.Password" Style="{StaticResource Muted}" Margin="0,10,0,4"/>
                <PasswordBox x:Name="AccLoginPassword"/>
