      <Border x:Name="Toast" Grid.Row="2" Panel.ZIndex="10" Width="380" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,36,28"
              Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="6" Padding="14,12" Visibility="Collapsed">
        <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.28"/></Border.Effect>
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock x:Name="ToastIcon" Style="{StaticResource Icon}" FontSize="16" VerticalAlignment="Top" Margin="0,1,12,0"/>
          <StackPanel Grid.Column="1">
            <TextBlock x:Name="ToastTitle" FontWeight="SemiBold" TextWrapping="Wrap" TextTrimming="None"/>
            <TextBlock x:Name="ToastText" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" TextTrimming="None" Margin="0,3,0,0"/>
            <ProgressBar x:Name="ToastProgress" Height="3" Maximum="100" Margin="0,8,0,0" Visibility="Collapsed"/>
            <StackPanel x:Name="ToastButtons" Orientation="Horizontal" Margin="0,10,0,0">
              <Button x:Name="ToastAction" Style="{StaticResource PrimaryButton}" Padding="12,3" MinHeight="26" Margin="0,0,8,0"/>
              <Button x:Name="ToastLater" x:Uid="Update.Later" Padding="12,3" MinHeight="26"/>
            </StackPanel>
          </StackPanel>
          <Button x:Name="ToastClose" Grid.Column="2" Style="{StaticResource GhostButton}" VerticalAlignment="Top" Margin="8,-4,-6,0" ToolTip="@Common.Close">
            <TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10"/>
          </Button>
        </Grid>
      </Border>
      <!-- ================= Строка состояния и журнал ================= -->
      <Border Grid.Row="3" Background="{DynamicResource Brush.LogBg}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0">
        <DockPanel>
          <Grid DockPanel.Dock="Top" Margin="16,3,12,3" MinHeight="26">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ToggleButton x:Name="LogToggle" IsChecked="False" Cursor="Hand" Background="Transparent" BorderThickness="0" FocusVisualStyle="{x:Null}" ToolTip="Ctrl+L" VerticalAlignment="Center">
              <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                  <StackPanel Orientation="Horizontal" Background="Transparent">
                    <TextBlock x:Name="chev" Text="&#xE70E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="9" Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center"/>
                    <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
                  </StackPanel>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="chev" Property="Text" Value="&#xE70D;"/></Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </ToggleButton.Template>
              <TextBlock x:Uid="Log.Title" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}"/>
            </ToggleButton>
            <TextBlock x:Name="LogLastLine" Grid.Column="1" Style="{StaticResource Muted}" Margin="14,0,12,0" VerticalAlignment="Center" FontSize="12"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Visibility="{Binding IsChecked, ElementName=LogToggle, Converter={StaticResource BoolToVis}}" Margin="0,0,12,0">
              <CheckBox x:Name="LogErrorsOnly" x:Uid="Log.ErrorsOnly" VerticalAlignment="Center" FontSize="12" Margin="0,0,8,0"/>
              <Button x:Name="LogCopyBtn" x:Uid="Log.Copy" Style="{StaticResource GhostButton}"/>
              <Button x:Name="LogClearBtn" x:Uid="Log.Clear" Style="{StaticResource GhostButton}"/>
              <Button x:Name="LogOpenBtn" x:Uid="Log.OpenFile" Style="{StaticResource GhostButton}"/>
            </StackPanel>
            <TextBlock x:Name="StatusRight" Grid.Column="3" Style="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center"/>
          </Grid>
          <TextBox x:Name="LogBox" Style="{StaticResource LogBox}" Height="160" Margin="16,0,8,8" Visibility="{Binding IsChecked, ElementName=LogToggle, Converter={StaticResource BoolToVis}}"/>
        </DockPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
