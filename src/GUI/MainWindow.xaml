                </Grid>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
              <StackPanel>
                <TextBlock x:Uid="Settings.Security" Style="{StaticResource CardTitle}"/>
                <CheckBox x:Name="SetKeychain" x:Uid="Settings.Keychain" Margin="0,4"/>
                <TextBlock x:Uid="Settings.KeychainNote" Style="{StaticResource Muted}" FontSize="11" Margin="27,0,0,8" TextWrapping="Wrap" TextTrimming="None"/>
                <CheckBox x:Name="SetDebug" x:Uid="Settings.Debug" Margin="0,4"/>
                <TextBlock x:Uid="Settings.DebugNote" Style="{StaticResource Muted}" FontSize="11" Margin="27,0,0,0" TextWrapping="Wrap" TextTrimming="None"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

