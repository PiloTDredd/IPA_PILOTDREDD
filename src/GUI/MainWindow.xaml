            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" MaxWidth="460"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="LibSearch" Tag="@Library.Placeholder"/>
