<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="IPA PILOTDREDD" Width="1240" Height="800" MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource Brush.Bg}" Foreground="{DynamicResource Brush.Text}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" AllowDrop="True">
  <Window.Resources>
    <Style x:Key="StatusText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Style.Triggers>
        <DataTrigger Binding="{Binding Status}" Value="Done"><Setter Property="Foreground" Value="{DynamicResource Brush.Success}"/></DataTrigger>
        <DataTrigger Binding="{Binding Status}" Value="OK"><Setter Property="Foreground" Value="{DynamicResource Brush.Success}"/></DataTrigger>
        <DataTrigger Binding="{Binding Status}" Value="Ready"><Setter Property="Foreground" Value="{DynamicResource Brush.Success}"/></DataTrigger>
        <DataTrigger Binding="{Binding Status}" Value="Success"><Setter Property="Foreground" Value="{DynamicResource Brush.Success}"/></DataTrigger>
        <DataTrigger Binding="{Binding Status}" Value="Downloaded"><Setter Property="Foreground" Value="{DynamicResource Brush.Success}"/></DataTrigger>
        <DataTrigger Binding="{Binding Status}" Value="UpdateAvailable"><Setter Property="Foreground" Value="{DynamicResource Brush.Accent}"/></DataTrigger>
        <DataTrigger Binding="{Binding Status}" Value="Error"><Setter Property="Foreground" Value="{DynamicResource Brush.Danger}"/></DataTrigger>
        <DataTrigger Binding="{Binding Status}" Value="Failed"><Setter Property="Foreground" Value="{DynamicResource Brush.Danger}"/></DataTrigger>
        <DataTrigger Binding="{Binding Status}" Value="Warning"><Setter Property="Foreground" Value="{DynamicResource Brush.Warning}"/></DataTrigger>
        <DataTrigger Binding="{Binding Status}" Value="NotInStore"><Setter Property="Foreground" Value="{DynamicResource Brush.Warning}"/></DataTrigger>
        <DataTrigger Binding="{Binding Status}" Value="NotTrusted"><Setter Property="Foreground" Value="{DynamicResource Brush.Warning}"/></DataTrigger>
        <DataTrigger Binding="{Binding Status}" Value="Cancelled"><Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}"/></DataTrigger>
        <DataTrigger Binding="{Binding Status}" Value="Unverified"><Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}"/></DataTrigger>
        <DataTrigger Binding="{Binding Status}" Value="Running"><Setter Property="Foreground" Value="{DynamicResource Brush.Accent}"/></DataTrigger>
        <DataTrigger Binding="{Binding Status}" Value="Queued"><Setter Property="Foreground" Value="{DynamicResource Brush.Accent}"/></DataTrigger>
        <DataTrigger Binding="{Binding Status}" Value="InstallQueued"><Setter Property="Foreground" Value="{DynamicResource Brush.Accent}"/></DataTrigger>
        <DataTrigger Binding="{Binding Status}" Value="Installing"><Setter Property="Foreground" Value="{DynamicResource Brush.Accent}"/></DataTrigger>
        <DataTrigger Binding="{Binding Status}" Value="Installed"><Setter Property="Foreground" Value="{DynamicResource Brush.Success}"/></DataTrigger>
        <DataTrigger Binding="{Binding Status}" Value="InstallError"><Setter Property="Foreground" Value="{DynamicResource Brush.Danger}"/></DataTrigger>
      </Style.Triggers>
    </Style>
    <!-- «Покупки»: плашка «На iPhone» (цвет по Badge строки) и кнопка главного действия (вид по Action). -->
    <Style x:Key="DeviceChip" TargetType="Border">
      <Setter Property="CornerRadius" Value="9"/>
      <Setter Property="Padding" Value="9,1,9,2"/>
      <Setter Property="HorizontalAlignment" Value="Left"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Background" Value="{DynamicResource Brush.Surface2}"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding HasBadge}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
        <DataTrigger Binding="{Binding Badge}" Value="Installed"><Setter Property="Background" Value="{DynamicResource Brush.SuccessSoft}"/></DataTrigger>
        <DataTrigger Binding="{Binding Badge}" Value="Outdated"><Setter Property="Background" Value="{DynamicResource Brush.OrangeSoft}"/></DataTrigger>
        <DataTrigger Binding="{Binding Badge}" Value="NeedIos"><Setter Property="Background" Value="{DynamicResource Brush.WarningSoft}"/></DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="DeviceChipText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding Badge}" Value="Installed"><Setter Property="Foreground" Value="{DynamicResource Brush.Success}"/></DataTrigger>
        <DataTrigger Binding="{Binding Badge}" Value="Outdated"><Setter Property="Foreground" Value="{DynamicResource Brush.Orange}"/></DataTrigger>
        <DataTrigger Binding="{Binding Badge}" Value="NeedIos"><Setter Property="Foreground" Value="{DynamicResource Brush.Warning}"/></DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="RowActionButton" TargetType="Button" BasedOn="{StaticResource RowButton}">
      <Setter Property="Width" Value="104"/>
      <Setter Property="HorizontalAlignment" Value="Left"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding Action}" Value="Install">
          <Setter Property="Background" Value="Transparent"/>
          <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
          <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}"/>
          <Setter Property="FontWeight" Value="SemiBold"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Action}" Value="Update">
          <Setter Property="Background" Value="{DynamicResource Brush.OrangeSoft}"/>
          <Setter Property="BorderBrush" Value="{DynamicResource Brush.OrangeBorder}"/>
          <Setter Property="Foreground" Value="{DynamicResource Brush.Orange}"/>
          <Setter Property="FontWeight" Value="SemiBold"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="EmptyTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="TextAlignment" Value="Center"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="TextTrimming" Value="None"/>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="212"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- ================= Боковая панель ================= -->
    <Border Grid.Column="0" Background="{DynamicResource Brush.Sidebar}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,1,0">
      <DockPanel LastChildFill="False">
        <StackPanel DockPanel.Dock="Top" Margin="18,18,12,16" Orientation="Horizontal">
          <Border Width="28" Height="28" CornerRadius="6" Background="{DynamicResource Brush.Accent}">
            <TextBlock Text="&#xE896;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource Brush.AccentText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="IPA PILOTDREDD" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="15" FontWeight="SemiBold"/>
            <TextBlock x:Name="AppVersionText" Style="{StaticResource Muted}" FontSize="11"/>
          </StackPanel>
        </StackPanel>

        <StackPanel DockPanel.Dock="Top">
          <RadioButton x:Name="NavHome" x:Uid="Nav.Home" Style="{StaticResource NavButton}" Tag="&#xE80F;" IsChecked="True"/>
          <RadioButton x:Name="NavPurchases" x:Uid="Nav.Purchases" Style="{StaticResource NavButton}" Tag="&#xE719;"/>
          <RadioButton x:Name="NavCatalog" x:Uid="Nav.Catalog" Style="{StaticResource NavButton}" Tag="&#xE721;"/>
          <RadioButton x:Name="NavDownloads" x:Uid="Nav.Downloads" Style="{StaticResource NavButton}" Tag="&#xE896;"/>
          <RadioButton x:Name="NavLibrary" x:Uid="Nav.Library" Style="{StaticResource NavButton}" Tag="&#xE8B7;"/>
          <!-- «Устройства» и «Apple ID» в меню не показываются: телефон — на «Главной», аккаунт — внизу. Экраны остаются. -->
          <RadioButton x:Name="NavDevices" x:Uid="Nav.Devices" Style="{StaticResource NavButton}" Tag="&#xE8EA;" Visibility="Collapsed"/>
          <Border Height="1" Background="{DynamicResource Brush.Border}" Margin="18,10"/>
          <RadioButton x:Name="NavAccounts" x:Uid="Nav.Accounts" Style="{StaticResource NavButton}" Tag="&#xE77B;" Visibility="Collapsed"/>
          <RadioButton x:Name="NavSettings" x:Uid="Nav.Settings" Style="{StaticResource NavButton}" Tag="&#xE713;"/>
          <RadioButton x:Name="NavDiagnostics" x:Uid="Nav.Diagnostics" Style="{StaticResource NavButton}" Tag="&#xE9D9;"/>
        </StackPanel>

        <!-- Аккаунт: буква-аватарка, по клику — страница Apple ID -->
        <Button x:Name="SideAccountBtn" DockPanel.Dock="Bottom" Margin="8,0,8,12" Style="{StaticResource GhostButton}" Padding="8,8" ToolTip="@Nav.Accounts">
          <Grid Width="176">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid Width="36" Height="36" Margin="0,0,10,0" VerticalAlignment="Center">
              <Ellipse Fill="{DynamicResource Brush.AccentSoft}" Stroke="{DynamicResource Brush.Accent}" StrokeThickness="2"/>
              <TextBlock x:Name="SideAvatarLetter" Text="?" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource Brush.Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              <!-- Точка-статус: зелёная — вход выполнен, жёлтая — нет. -->
              <Ellipse x:Name="SideAccountDot" Width="11" Height="11" Fill="{DynamicResource Brush.Warning}" Stroke="{DynamicResource Brush.Sidebar}" StrokeThickness="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-1,-1"/>
            </Grid>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock x:Name="SideAccountText" FontSize="13" HorizontalAlignment="Left"/>
              <TextBlock x:Name="SideAccountDetail" Style="{StaticResource Muted}" FontSize="11" HorizontalAlignment="Left" Margin="0,1,0,0"/>
            </StackPanel>
          </Grid>
        </Button>
        <!-- «На кофе»: та же ссылка, что «Поддержать PILOTDREDD» (настройка TipJarUrl) -->
        <Button x:Name="SideTipBtn" DockPanel.Dock="Bottom" Margin="8,0,8,8" MinHeight="40" Background="{DynamicResource Brush.OrangeSoft}" BorderBrush="{DynamicResource Brush.OrangeBorder}" ToolTip="@Diag.TipJarHint">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#x2615;" FontFamily="Segoe UI Emoji, Segoe UI Symbol" FontSize="16" Foreground="{DynamicResource Brush.Orange}" VerticalAlignment="Center"/>
            <TextBlock x:Uid="Side.TipJar" FontSize="15" Foreground="{DynamicResource Brush.Orange}" Margin="10,0,0,0" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
      </DockPanel>
    </Border>

    <!-- ================= Основная область ================= -->
    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- Заголовок страницы -->
      <Grid Grid.Row="0" Margin="24,16,24,12">
        <StackPanel>
          <TextBlock x:Name="PageTitle" Style="{StaticResource H1}"/>
          <TextBlock x:Name="PageSubtitle" Style="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0"/>
        </StackPanel>
        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
          <TextBlock x:Name="GlobalBusyText" Style="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" MaxWidth="360" Margin="0,0,10,0"/>
          <ProgressBar x:Name="GlobalBusy" Width="96" Height="3" IsIndeterminate="True" Visibility="Collapsed"/>
        </StackPanel>
      </Grid>

      <!-- Сообщение автора списков (Files/Warning.txt) -->
      <Border x:Name="WarningBanner" Grid.Row="1" Background="{DynamicResource Brush.WarningSoft}" BorderBrush="{DynamicResource Brush.Warning}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="24,0,24,12" Visibility="Collapsed">
        <DockPanel>
          <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" Foreground="{DynamicResource Brush.Warning}" Margin="0,0,10,0" DockPanel.Dock="Left"/>
          <Button x:Name="WarningClose" DockPanel.Dock="Right" Style="{StaticResource GhostButton}" ToolTip="@Common.Close" Margin="8,0,0,0">
            <TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10"/>
          </Button>
          <TextBlock x:Name="WarningText" TextWrapping="Wrap" TextTrimming="None" VerticalAlignment="Center"/>
        </DockPanel>
      </Border>

      <!-- ================= Страницы ================= -->
      <Grid Grid.Row="2" Margin="24,0,24,12">

        <!-- ===== Главная ===== -->
        <ScrollViewer x:Name="PageHome" VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="0,0,4,0">

            <!-- Первые шаги: компоненты → Apple ID → iPhone -->
            <Border x:Name="HomeSetupCard" Style="{StaticResource Card}" CornerRadius="12" Padding="20,18" Margin="0,0,0,14" Visibility="Collapsed">
              <StackPanel>
                <TextBlock x:Uid="Home.Setup.Title" FontSize="18" FontWeight="SemiBold"/>
                <DockPanel Margin="0,10,0,14">
                  <TextBlock x:Name="HomeSetupProgressText" Style="{StaticResource Muted}" FontSize="13" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,14,0"/>
                  <ProgressBar x:Name="HomeSetupProgress" Maximum="3" Height="6" VerticalAlignment="Center"/>
                </DockPanel>
                <Border x:Name="HomeStep1" CornerRadius="10" Padding="14,12" Margin="0,0,0,8" Background="{DynamicResource Brush.Surface2}" BorderThickness="1" BorderBrush="Transparent">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Grid Width="34" Height="34" Margin="0,0,14,0" VerticalAlignment="Center">
                      <Ellipse x:Name="HomeStep1Circle" StrokeThickness="2"/>
                      <TextBlock x:Name="HomeStep1Num" Text="1" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock x:Uid="Home.Step1.Title" FontSize="15" FontWeight="SemiBold"/>
                      <TextBlock x:Name="HomeStep1Text" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" TextTrimming="None" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button x:Name="HomeStep1Btn" Grid.Column="2" MinWidth="120" MinHeight="36" Margin="12,0,0,0" VerticalAlignment="Center"><TextBlock x:Uid="Home.Step1.Action"/></Button>
                    <TextBlock x:Name="HomeStep1Done" Grid.Column="2" x:Uid="Home.Step.Done" Foreground="{DynamicResource Brush.Success}" VerticalAlignment="Center" Margin="12,0,6,0"/>
                  </Grid>
                </Border>
                <Border x:Name="HomeStep2" CornerRadius="10" Padding="14,12" Margin="0,0,0,8" Background="{DynamicResource Brush.Surface2}" BorderThickness="1" BorderBrush="Transparent">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Grid Width="34" Height="34" Margin="0,0,14,0" VerticalAlignment="Center">
                      <Ellipse x:Name="HomeStep2Circle" StrokeThickness="2"/>
                      <TextBlock x:Name="HomeStep2Num" Text="2" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock x:Uid="Home.Step2.Title" FontSize="15" FontWeight="SemiBold"/>
                      <TextBlock x:Name="HomeStep2Text" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" TextTrimming="None" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button x:Name="HomeStep2Btn" Grid.Column="2" MinWidth="120" MinHeight="36" Margin="12,0,0,0" VerticalAlignment="Center"><TextBlock x:Uid="Home.Step2.Action"/></Button>
                    <TextBlock x:Name="HomeStep2Done" Grid.Column="2" x:Uid="Home.Step.Done" Foreground="{DynamicResource Brush.Success}" VerticalAlignment="Center" Margin="12,0,6,0"/>
                  </Grid>
                </Border>
                <Border x:Name="HomeStep3" CornerRadius="10" Padding="14,12" Background="{DynamicResource Brush.Surface2}" BorderThickness="1" BorderBrush="Transparent">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Grid Width="34" Height="34" Margin="0,0,14,0" VerticalAlignment="Center">
                      <Ellipse x:Name="HomeStep3Circle" StrokeThickness="2"/>
                      <TextBlock x:Name="HomeStep3Num" Text="3" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock x:Uid="Home.Step3.Title" FontSize="15" FontWeight="SemiBold"/>
                      <TextBlock x:Name="HomeStep3Text" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" TextTrimming="None" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button x:Name="HomeStep3Btn" Grid.Column="2" MinWidth="120" MinHeight="36" Margin="12,0,0,0" VerticalAlignment="Center"><TextBlock x:Uid="Home.Step3.Action"/></Button>
                    <TextBlock x:Name="HomeStep3Done" Grid.Column="2" x:Uid="Home.Step.Done" Foreground="{DynamicResource Brush.Success}" VerticalAlignment="Center" Margin="12,0,6,0"/>
                  </Grid>
                </Border>
              </StackPanel>
            </Border>

            <!-- Карточка iPhone -->
            <Border x:Name="HomeDevCard" Style="{StaticResource Card}" CornerRadius="12" Padding="20,18" Margin="0,0,0,14">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border x:Name="HomePhoneShape" Width="54" Height="92" CornerRadius="12" BorderThickness="2" Margin="0,0,22,0" VerticalAlignment="Center"
                        BorderBrush="{DynamicResource Brush.Accent}" Background="{DynamicResource Brush.AccentSoft}">
                  <Border x:Name="HomePhoneNotch" Width="16" Height="5" CornerRadius="2.5" Background="{DynamicResource Brush.Accent}" VerticalAlignment="Top" Margin="0,6,0,0"/>
                </Border>
                <StackPanel x:Name="HomeDevInfo" Grid.Column="1" VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="HomeDevName" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="20" FontWeight="SemiBold" MaxWidth="420"/>
                    <Border CornerRadius="10" Padding="9,2" Margin="10,0,0,0" Background="{DynamicResource Brush.SuccessSoft}" VerticalAlignment="Center">
                      <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" Fill="{DynamicResource Brush.Success}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="HomeDevConn" FontSize="12" Foreground="{DynamicResource Brush.Success}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                      </StackPanel>
                    </Border>
                  </StackPanel>
                  <TextBlock x:Name="HomeDevDetails" Style="{StaticResource Muted}" FontSize="13" Margin="0,4,0,0"/>
                  <!-- Полоса не шире 460 и прижата влево: остаток забирает пустая вторая колонка
                       (одна колонка с MaxWidth центрируется, как и StackPanel с MaxWidth). -->
                  <Grid x:Name="HomeDevSpacePanel" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="100*" MaxWidth="460"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel>
                      <ProgressBar x:Name="HomeDevSpaceBar" Height="8" Maximum="100"/>
                      <TextBlock x:Name="HomeDevSpaceText" Style="{StaticResource Muted}" FontSize="12" Margin="0,5,0,0"/>
                    </StackPanel>
                  </Grid>
                </StackPanel>
                <StackPanel x:Name="HomeNoDevInfo" Grid.Column="1" VerticalAlignment="Center" Visibility="Collapsed">
                  <TextBlock x:Name="HomeNoDevTitle" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="20" FontWeight="SemiBold"/>
                  <TextBlock x:Name="HomeNoDevText" Style="{StaticResource Muted}" FontSize="13" TextWrapping="Wrap" TextTrimming="None" Margin="0,4,0,0" MaxWidth="560" HorizontalAlignment="Left"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Width="232" VerticalAlignment="Center" Margin="20,0,0,0">
                  <Button x:Name="HomeInstallBtn" Style="{StaticResource PrimaryButton}" MinHeight="40">
                    <TextBlock x:Uid="Home.InstallIpa" Foreground="{DynamicResource Brush.AccentText}"/>
                  </Button>
                  <Button x:Name="HomeScanBtn" Style="{StaticResource PrimaryButton}" MinHeight="40" Visibility="Collapsed">
                    <TextBlock x:Uid="Home.ScanAgain" Foreground="{DynamicResource Brush.AccentText}"/>
                  </Button>
                  <Button x:Name="HomeDevicesBtn" Margin="0,8,0,0" MinHeight="34"><TextBlock x:Name="HomeDevicesBtnText"/></Button>
                  <TextBlock x:Uid="Home.DropHint" Style="{StaticResource Muted}" FontSize="11" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                </StackPanel>
              </Grid>
            </Border>

            <!-- Три плитки → вкладки «Покупок» -->
            <UniformGrid Columns="3" Margin="0,0,0,14">
              <Button x:Name="HomeTileMissing" Style="{StaticResource TileButton}" Margin="0,0,7,0">
                <StackPanel>
                  <Grid>
                    <TextBlock x:Name="HomeTileMissingCount" Text="—" FontSize="30" FontWeight="SemiBold"/>
                    <TextBlock Text="&#xE72A;" Style="{StaticResource Icon}" HorizontalAlignment="Right"/>
                  </Grid>
                  <TextBlock x:Uid="Home.Tile.Missing" FontSize="15" FontWeight="SemiBold" Margin="0,6,0,0"/>
                  <TextBlock x:Name="HomeTileMissingText" Style="{StaticResource Muted}" FontSize="12" Margin="0,3,0,0"/>
                </StackPanel>
              </Button>
              <Button x:Name="HomeTileOn" Style="{StaticResource TileButton}" Margin="7,0,7,0">
                <StackPanel>
                  <Grid>
                    <TextBlock x:Name="HomeTileOnCount" Text="—" FontSize="30" FontWeight="SemiBold"/>
                    <TextBlock Text="&#xE72A;" Style="{StaticResource Icon}" HorizontalAlignment="Right"/>
                  </Grid>
                  <TextBlock x:Uid="Home.Tile.On" FontSize="15" FontWeight="SemiBold" Margin="0,6,0,0"/>
                  <TextBlock x:Name="HomeTileOnText" Style="{StaticResource Muted}" FontSize="12" Margin="0,3,0,0"/>
                </StackPanel>
              </Button>
              <Button x:Name="HomeTileUpdate" Style="{StaticResource TileButton}" Margin="7,0,0,0" Background="{DynamicResource Brush.OrangeSoft}" BorderBrush="{DynamicResource Brush.OrangeBorder}">
                <StackPanel>
                  <Grid>
                    <TextBlock x:Name="HomeTileUpdateCount" Text="—" FontSize="30" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Orange}"/>
                    <TextBlock Text="&#xE72A;" Style="{StaticResource Icon}" Foreground="{DynamicResource Brush.Orange}" HorizontalAlignment="Right"/>
                  </Grid>
                  <TextBlock x:Uid="Home.Tile.Update" FontSize="15" FontWeight="SemiBold" Margin="0,6,0,0"/>
                  <TextBlock x:Name="HomeTileUpdateText" Style="{StaticResource Muted}" FontSize="12" Margin="0,3,0,0"/>
                </StackPanel>
              </Button>
            </UniformGrid>

            <!-- Текущая загрузка и «Недавно» -->
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Border x:Name="HomeDlCard" Style="{StaticResource Card}" CornerRadius="12" Padding="18,16" Margin="0,0,7,0" MinHeight="196">
                <Grid>
                  <StackPanel x:Name="HomeDlActive" Visibility="Collapsed">
                    <DockPanel>
                      <Button x:Name="HomeDlQueueLink" DockPanel.Dock="Right" Style="{StaticResource LinkButton}" VerticalAlignment="Center">
                        <TextBlock x:Name="HomeDlQueueText" FontSize="12"/>
                      </Button>
                      <TextBlock x:Uid="Home.NowDownloading" FontSize="14" FontWeight="SemiBold"/>
                    </DockPanel>
                    <Grid Margin="0,14,0,0">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <Border Width="44" Height="44" CornerRadius="10" Background="{DynamicResource Brush.AccentSoft}" Margin="0,0,12,0">
                        <TextBlock x:Name="HomeDlInitial" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource Brush.Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      </Border>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding AppName}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0"/>
                      </StackPanel>
                      <TextBlock Grid.Column="2" Text="{Binding Progress, StringFormat={}{0:0}%}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    </Grid>
                    <ProgressBar Value="{Binding Progress, Mode=OneWay}" IsIndeterminate="{Binding IsIndeterminate, Mode=OneWay}" Maximum="100" Height="8" Margin="0,14,0,0"/>
                    <DockPanel Margin="0,10,0,0">
                      <Button x:Name="HomeDlCancelBtn" DockPanel.Dock="Right" x:Uid="Common.Cancel" MinWidth="84"/>
                      <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    </DockPanel>
                  </StackPanel>
                  <StackPanel x:Name="HomeDlEmpty" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" FontSize="30" HorizontalAlignment="Center"/>
                    <TextBlock x:Uid="Home.QueueEmpty" Style="{StaticResource EmptyTitle}" Margin="0,10,0,0"/>
                    <TextBlock x:Uid="Home.QueueEmptyText" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" TextTrimming="None" TextAlignment="Center" MaxWidth="300" Margin="0,4,0,8"/>
                    <Button x:Name="HomeOpenPurchasesBtn" Style="{StaticResource LinkButton}" HorizontalAlignment="Center"><TextBlock x:Uid="Home.OpenPurchases"/></Button>
                  </StackPanel>
                </Grid>
              </Border>
              <Border Grid.Column="1" Style="{StaticResource Card}" CornerRadius="12" Padding="18,16" Margin="7,0,0,0" MinHeight="196">
                <StackPanel>
                  <DockPanel>
                    <Button x:Name="HomeAllDownloadsBtn" DockPanel.Dock="Right" Style="{StaticResource LinkButton}" VerticalAlignment="Center"><TextBlock x:Uid="Home.AllDownloads" FontSize="12"/></Button>
                    <TextBlock x:Uid="Home.Recent" FontSize="14" FontWeight="SemiBold"/>
                  </DockPanel>
                  <ItemsControl x:Name="HomeRecentList" Margin="0,12,0,0" Focusable="False">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Grid Margin="0,0,0,10" ToolTip="{Binding Detail}">
                          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                          <Border Width="34" Height="34" CornerRadius="8" Background="{DynamicResource Brush.Surface2}" Margin="0,0,12,0">
                            <TextBlock Text="{Binding C1}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                          </Border>
                          <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding C2}" FontSize="13"/>
                            <TextBlock Text="{Binding C3}" Style="{StaticResource Muted}" FontSize="11" Margin="0,1,0,0"/>
                          </StackPanel>
                          <TextBlock Grid.Column="2" Text="{Binding C5}" Style="{StaticResource StatusText}" FontSize="12" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock x:Name="HomeRecentEmpty" x:Uid="Home.RecentEmpty" Style="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0"/>
                </StackPanel>
              </Border>
            </Grid>
          </StackPanel>
        </ScrollViewer>

        <!-- ===== Покупки ===== -->
        <Grid x:Name="PagePurchases" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <!-- Шапка: слева «сколько приложений · когда обновлено» и ↻, справа — с каким iPhone сравнено. -->
          <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock x:Name="PurInfoText" Style="{StaticResource Muted}" FontSize="13" VerticalAlignment="Center"/>
              <Button x:Name="PurScanBtn" Style="{StaticResource GhostButton}" Margin="6,0,0,0" Padding="6,2" ToolTip="@Purchases.ScanHint">
                <TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center"/>
              </Button>
              <Button x:Name="PurCancelBtn" x:Uid="Common.Cancel" Style="{StaticResource GhostButton}" Margin="6,0,0,0" Visibility="Collapsed"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
              <Ellipse x:Name="PurDevDot" Width="8" Height="8" Fill="{DynamicResource Brush.Success}" Margin="0,0,8,0" VerticalAlignment="Center" Visibility="Collapsed"/>
              <TextBlock x:Name="PurDevInfo" Style="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/>
              <Button x:Name="PurDeviceBtn" Style="{StaticResource LinkButton}" VerticalAlignment="Center" ToolTip="@Purchases.DeviceScanHint">
                <TextBlock x:Name="PurDeviceBtnText" FontSize="12"/>
              </Button>
            </StackPanel>
          </Grid>
          <!-- Поиск, четыре главные вкладки и «Фильтр» для редкого. -->
          <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" MaxWidth="340"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="PurSearch" Tag="@Purchases.Placeholder"/>
            <Border Grid.Column="1" Margin="12,0,0,0" Padding="3" CornerRadius="7" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
              <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="PurTabAll" Style="{StaticResource SegTab}" GroupName="PurTab" IsChecked="True"/>
                <RadioButton x:Name="PurTabNotOnDevice" Style="{StaticResource SegTab}" GroupName="PurTab"/>
                <RadioButton x:Name="PurTabOnDevice" Style="{StaticResource SegTab}" GroupName="PurTab"/>
                <RadioButton x:Name="PurTabDownloaded" Style="{StaticResource SegTab}" GroupName="PurTab"/>
              </StackPanel>
            </Border>
            <Button x:Name="PurFilterBtn" Grid.Column="2" Margin="8,0,0,0" MinHeight="34">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE71C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" VerticalAlignment="Center"/>
                <TextBlock x:Name="PurFilterText" Margin="8,0,0,0" VerticalAlignment="Center"/>
                <TextBlock Text="&#xE70D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" Margin="8,1,0,0" VerticalAlignment="Center"/>
              </StackPanel>
              <Button.ContextMenu>
                <ContextMenu x:Name="PurFilterMenu">
                  <MenuItem x:Name="PurFltDeviceOutdated" x:Uid="Purchases.Flt.DeviceOutdated"/>
                  <MenuItem x:Name="PurFltUpdateAvailable" x:Uid="Purchases.Flt.UpdateAvailable"/>
                  <MenuItem x:Name="PurFltNotInStore" x:Uid="Purchases.Flt.NotInStore"/>
                  <MenuItem x:Name="PurFltIncompatible" x:Uid="Purchases.Flt.Incompatible"/>
                  <MenuItem x:Name="PurFltFailed" x:Uid="Purchases.Flt.Failed"/>
                  <Separator/>
                  <MenuItem x:Name="PurFltReset" x:Uid="Purchases.FilterReset"/>
                </ContextMenu>
              </Button.ContextMenu>
            </Button>
          </Grid>
          <Border Grid.Row="2" Style="{StaticResource Card}" Padding="4">
            <Grid>
              <DataGrid x:Name="PurGrid" SelectionMode="Extended" RowHeight="48" CanUserSortColumns="True">
                <DataGrid.ContextMenu>
                  <ContextMenu x:Name="PurMenu">
                    <MenuItem x:Name="PurMenuInstall" Header="—"/>
                    <MenuItem x:Name="PurMenuDownload" x:Uid="Catalog.Download" InputGestureText="Enter"/>
                    <MenuItem x:Name="PurMenuVersion" x:Uid="Catalog.ChooseVersion"/>
                    <MenuItem x:Name="PurMenuShow" x:Uid="Common.ShowInFolder"/>
                    <MenuItem x:Name="PurMenuUninstall" x:Uid="Purchases.Uninstall"/>
                    <Separator/>
                    <MenuItem x:Name="PurMenuStore" x:Uid="Purchases.OpenStore"/>
                    <MenuItem x:Name="PurMenuCopyId" x:Uid="Catalog.CopyId" InputGestureText="Ctrl+C"/>
                    <MenuItem x:Name="PurMenuRetry" x:Uid="Purchases.RetryFailed"/>
                  </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                  <DataGridTemplateColumn Header="@Col.App" Width="*" SortMemberPath="Name">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <DockPanel VerticalAlignment="Center">
                          <Grid Width="32" Height="32" Margin="0,0,12,0" DockPanel.Dock="Left">
                            <Border CornerRadius="7" Background="{DynamicResource Brush.Surface2}">
                              <TextBlock Text="{Binding Initial}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border CornerRadius="7" Visibility="{Binding HasIcon, Converter={StaticResource BoolToVis}}">
                              <Border.Background><ImageBrush ImageSource="{Binding Icon}" Stretch="UniformToFill"/></Border.Background>
                            </Border>
                          </Grid>
                          <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" ToolTip="{Binding Name}"/>
                            <!-- Вторая строка: «разработчик · куплено …» либо заметка (загрузка, ошибка, нет в App Store). -->
                            <TextBlock Text="{Binding SubText}" Style="{StaticResource Muted}" FontSize="12" Margin="0,1,0,0"
                                       Visibility="{Binding NoNote, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock Text="{Binding Note}" Style="{StaticResource StatusText}" FontSize="12" Margin="0,1,0,0" ToolTip="{Binding StatusDetail}"
                                       Visibility="{Binding HasNote, Converter={StaticResource BoolToVis}}"/>
                            <ProgressBar Value="{Binding Progress}" IsIndeterminate="{Binding IsIndeterminate}" Maximum="100" Height="3" Margin="0,3,24,0"
                                         Visibility="{Binding ShowProgress, Converter={StaticResource BoolToVis}}"/>
                          </StackPanel>
                        </DockPanel>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTemplateColumn Header="@Col.Version" Width="150" CanUserSort="False">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                          <TextBlock Text="{Binding VersionText}" VerticalAlignment="Center" ToolTip="{Binding StatusDetail}"/>
                          <Border CornerRadius="5" Padding="6,0,6,1" Margin="6,0,0,0" VerticalAlignment="Center" Background="{DynamicResource Brush.AccentSoft}"
                                  ToolTip="{Binding PcHint}" Visibility="{Binding IsOnPc, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding PcText}" FontSize="11" Foreground="{DynamicResource Brush.Accent}"/>
                          </Border>
                        </StackPanel>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn Header="@Col.Size" Binding="{Binding SizeText}" SortMemberPath="SizeBytes" Width="84"/>
                  <DataGridTemplateColumn Header="@Col.OnDevice" Width="150" SortMemberPath="DeviceOrder" Visibility="Collapsed">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <Border Style="{StaticResource DeviceChip}" ToolTip="{Binding DeviceDetail}">
                          <TextBlock Text="{Binding DeviceText}" Style="{StaticResource DeviceChipText}"/>
                        </Border>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <!-- Одна кнопка — главное действие строки (Get-DreddPurchaseRowAction); всё редкое — в «⋯». -->
                  <DataGridTemplateColumn Width="132" CanUserSort="False">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <Button Style="{StaticResource RowActionButton}" Content="{Binding ActionText}" IsEnabled="{Binding ActionEnabled}" Tag="{Binding}" CommandParameter="action"
                                ToolTip="{Binding DeviceDetail}" ToolTipService.ShowOnDisabled="True" Focusable="False"
                                Visibility="{Binding HasAction, Converter={StaticResource BoolToVis}}"/>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTemplateColumn Width="44" CanUserSort="False" CanUserResize="False">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <Button Style="{StaticResource GhostButton}" Tag="{Binding}" CommandParameter="more" Width="32" Padding="0" Focusable="False" HorizontalAlignment="Left">
                          <TextBlock Text="&#xE712;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"/>
                        </Button>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                </DataGrid.Columns>
              </DataGrid>
              <StackPanel x:Name="PurEmptyPanel" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460" Margin="0,0,0,24">
                <TextBlock x:Name="PurEmptyIcon" Text="&#xE719;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="28" Foreground="{DynamicResource Brush.TextMuted}" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                <TextBlock x:Name="PurEmptyTitle" Style="{StaticResource EmptyTitle}"/>
                <TextBlock x:Name="PurEmptyText" Style="{StaticResource Muted}" TextWrapping="Wrap" TextTrimming="None" TextAlignment="Center" Margin="0,6,0,0"/>
                <ProgressBar x:Name="PurBusy" IsIndeterminate="True" Width="220" Height="3" Margin="0,14,0,0" Visibility="Collapsed"/>
                <Button x:Name="PurEmptyBtn" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center" Margin="0,14,0,0" MinWidth="160"/>
              </StackPanel>
            </Grid>
          </Border>
          <!-- Низ: без выбора — только счётчик и подсказка; при выборе — панель действий. -->
          <Grid Grid.Row="3" Margin="0,10,0,0" MinHeight="46">
            <Grid x:Name="PurFootPanel" VerticalAlignment="Center" Margin="4,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="PurSelText" Style="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="1" x:Uid="Purchases.FootDbl" Style="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0"/>
            </Grid>
            <Border x:Name="PurSelBar" Visibility="Collapsed" CornerRadius="8" Padding="14,6,6,6" Background="{DynamicResource Brush.AccentSoft}" BorderBrush="{DynamicResource Brush.Accent}" BorderThickness="1">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="PurSelCount" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock x:Name="PurSelNames" Grid.Column="1" Style="{StaticResource Muted}" FontSize="12" Margin="12,0" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                  <!-- Видна, только когда выбраны приложения, которые стоят на iPhone. -->
                  <Button x:Name="PurUninstallBtn" Style="{StaticResource DangerButton}" Margin="0,0,8,0" Visibility="Collapsed">
                    <TextBlock x:Name="PurUninstallText"/>
                  </Button>
                  <Button x:Name="PurInstallBtn" Style="{StaticResource PrimaryButton}" MinWidth="150" Margin="0,0,8,0" ToolTip="@Purchases.InstallHint">
                    <TextBlock x:Name="PurInstallText" Foreground="{DynamicResource Brush.AccentText}"/>
                  </Button>
                  <Button x:Name="PurSelMoreBtn" Width="36" Padding="0" Margin="0,0,4,0" ToolTip="@Purchases.More">
                    <TextBlock Text="&#xE712;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"/>
                  </Button>
                  <Button x:Name="PurSelClearBtn" Style="{StaticResource GhostButton}" Width="36" Padding="0" MinHeight="30" ToolTip="@Purchases.ClearSel">
                    <TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12"/>
                  </Button>
                </StackPanel>
              </Grid>
            </Border>
          </Grid>
        </Grid>

        <!-- ===== Поиск ===== -->
        <Grid x:Name="PageCatalog" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="CatalogQuery" Tag="@Catalog.Placeholder"/>
            <Button x:Name="CatalogSearchBtn" Grid.Column="1" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0">
              <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{DynamicResource Brush.AccentText}" VerticalAlignment="Center"/><TextBlock x:Uid="Catalog.SearchStore" Margin="8,0,0,0" Foreground="{DynamicResource Brush.AccentText}"/></StackPanel>
            </Button>
            <Button x:Name="CatalogCancelBtn" Grid.Column="2" x:Uid="Common.Cancel" Margin="8,0,0,0" Visibility="Collapsed"/>
          </Grid>
          <WrapPanel Grid.Row="1" Margin="2,0,0,6">
            <RadioButton x:Name="SrcPopular" x:Uid="Catalog.SrcPopular" Style="{StaticResource FilterTab}" GroupName="CatalogSrc" IsChecked="True"/>
            <RadioButton x:Name="SrcSearch" x:Uid="Catalog.SrcAll" Style="{StaticResource FilterTab}" GroupName="CatalogSrc"/>
            <RadioButton x:Name="SrcCustom" x:Uid="Catalog.SrcCustom" Style="{StaticResource FilterTab}" GroupName="CatalogSrc"/>
          </WrapPanel>
          <Border Grid.Row="2" Style="{StaticResource Card}" Padding="4">
            <Grid>
              <DataGrid x:Name="CatalogGrid" SelectionMode="Extended" RowHeight="40">
                <DataGrid.ContextMenu>
                  <ContextMenu>
                    <MenuItem x:Name="CatMenuDownload" x:Uid="Catalog.Download" InputGestureText="Enter"/>
                    <MenuItem x:Name="CatMenuInstall" x:Uid="Purchases.DownloadInstall"/>
                    <MenuItem x:Name="CatMenuVersion" x:Uid="Catalog.ChooseVersion"/>
                    <MenuItem x:Name="CatMenuPurchase" x:Uid="Catalog.PurchaseOnly"/>
                    <Separator/>
                    <MenuItem x:Name="CatMenuAddCustom" x:Uid="Catalog.AddCustom"/>
                    <MenuItem x:Name="CatMenuCopyId" x:Uid="Catalog.CopyId" InputGestureText="Ctrl+C"/>
                  </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                  <DataGridTemplateColumn Header="@Col.Name" Width="*" SortMemberPath="Name">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <DockPanel VerticalAlignment="Center">
                          <Grid Width="26" Height="26" Margin="0,0,10,0" DockPanel.Dock="Left">
                            <Border CornerRadius="6" Background="{DynamicResource Brush.Surface2}">
                              <TextBlock Text="{Binding Initial}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border CornerRadius="6" Visibility="{Binding HasIcon, Converter={StaticResource BoolToVis}}">
                              <Border.Background><ImageBrush ImageSource="{Binding Icon}" Stretch="UniformToFill"/></Border.Background>
                            </Border>
                          </Grid>
                          <TextBlock Text="{Binding Name}" VerticalAlignment="Center" ToolTip="{Binding Name}"/>
                        </DockPanel>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn Header="@Col.AppId" Binding="{Binding Id}" Width="116"/>
                  <DataGridTextColumn Header="@Col.Version" Binding="{Binding Version}" Width="96"/>
                  <DataGridTextColumn Header="@Col.Source" Binding="{Binding SourceText}" Width="116"/>
                  <DataGridTextColumn Header="@Col.Status" Binding="{Binding StatusText}" Width="170"/>
                </DataGrid.Columns>
              </DataGrid>
              <StackPanel x:Name="CatalogEmptyPanel" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460">
                <TextBlock x:Name="CatalogEmptyIcon" Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="28" Foreground="{DynamicResource Brush.TextMuted}" HorizontalAlignment="Center"/>
                <TextBlock x:Name="CatalogEmptyText" Style="{StaticResource Muted}" TextWrapping="Wrap" TextTrimming="None" TextAlignment="Center" Margin="0,10,0,0"/>
                <ProgressBar x:Name="CatalogBusy" IsIndeterminate="True" Width="200" Height="3" Margin="0,12,0,0" Visibility="Collapsed"/>
              </StackPanel>
            </Grid>
          </Border>
          <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock x:Name="CatalogCount" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,16,0"/>
              <CheckBox x:Name="CatalogAutoPurchase" x:Uid="Catalog.AutoPurchaseShort" ToolTip="@Common.AutoPurchase" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
              <Button x:Name="CatalogVersionBtn" x:Uid="Catalog.ChooseVersion" Margin="0,0,8,0"/>
              <!-- «Скачать» кладёт IPA только на компьютер — установка на телефон отдельной заметной кнопкой. -->
              <Button x:Name="CatalogInstallBtn" Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8EA;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" VerticalAlignment="Center"/><TextBlock x:Uid="Catalog.ToIphone" Margin="8,0,0,0"/></StackPanel>
              </Button>
              <Button x:Name="CatalogDownloadBtn" Style="{StaticResource PrimaryButton}">
                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE896;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{DynamicResource Brush.AccentText}" VerticalAlignment="Center"/><TextBlock x:Uid="Catalog.Download" Margin="8,0,0,0" Foreground="{DynamicResource Brush.AccentText}"/></StackPanel>
              </Button>
            </StackPanel>
          </Grid>
        </Grid>

        <!-- ===== Загрузки ===== -->
        <Grid x:Name="PageDownloads" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="200"/>
          </Grid.RowDefinitions>
          <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Uid="Downloads.Folder" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBox x:Name="DlFolder" Grid.Column="1" IsReadOnly="True"/>
            <Button x:Name="DlChangeFolderBtn" Grid.Column="2" x:Uid="Common.Change" Margin="8,0,0,0"/>
            <Button x:Name="DlOpenFolderBtn" Grid.Column="3" x:Uid="Common.Open" Margin="8,0,0,0"/>
          </Grid>
          <Border Grid.Row="1" Style="{StaticResource Card}" Padding="4">
            <Grid>
              <DataGrid x:Name="DlQueueGrid" SelectionMode="Extended" RowHeight="44">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="@Col.Name" Binding="{Binding AppName}" Width="*"/>
                  <DataGridTextColumn Header="@Col.Version" Binding="{Binding VersionText}" Width="100"/>
                  <DataGridTemplateColumn Header="@Col.Status" Width="130">
                    <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding StatusText}" Style="{StaticResource StatusText}" ToolTip="{Binding Error}"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTemplateColumn Header="@Col.Progress" Width="210">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <StackPanel VerticalAlignment="Center" Visibility="{Binding ShowProgress, Converter={StaticResource BoolToVis}}" Margin="0,0,10,0">
                          <ProgressBar Value="{Binding Progress}" IsIndeterminate="{Binding IsIndeterminate}" Maximum="100" Height="4"/>
                          <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Muted}" FontSize="11" Margin="0,3,0,0"/>
                        </StackPanel>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTemplateColumn Header="@Col.File" Width="*">
                    <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding FileName}" ToolTip="{Binding Error}"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                </DataGrid.Columns>
              </DataGrid>
              <TextBlock x:Name="DlQueueEmpty" x:Uid="Downloads.Empty" Style="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextTrimming="None" TextAlignment="Center" MaxWidth="420"/>
            </Grid>
          </Border>
          <Grid Grid.Row="2" Margin="0,10,0,14">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <CheckBox x:Name="DlAutoPurchase" x:Uid="Catalog.AutoPurchaseShort" ToolTip="@Common.AutoPurchase" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
              <Button x:Name="DlShowFileBtn" x:Uid="Common.ShowInFolder" Margin="0,0,8,0"/>
              <Button x:Name="DlClearBtn" x:Uid="Downloads.ClearDone" Margin="0,0,8,0"/>
              <Button x:Name="DlRetryBtn" x:Uid="Downloads.Retry" Margin="0,0,8,0"/>
              <Button x:Name="DlCancelBtn" x:Uid="Downloads.CancelSelected" Margin="0,0,8,0"/>
              <Button x:Name="DlCancelAllBtn" x:Uid="Downloads.CancelAll" Style="{StaticResource DangerButton}"/>
            </StackPanel>
          </Grid>
          <Grid Grid.Row="3" Margin="0,0,0,6">
            <TextBlock x:Uid="Downloads.History" Style="{StaticResource CardTitle}" VerticalAlignment="Center" Margin="0"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <Button x:Name="DlHistoryRemoveBtn" x:Uid="Downloads.HistoryRemove" Style="{StaticResource GhostButton}" ToolTip="Delete" Margin="0,0,4,0"/>
              <Button x:Name="DlHistoryClearBtn" x:Uid="Downloads.HistoryClear" Style="{StaticResource GhostButton}"/>
            </StackPanel>
          </Grid>
          <Border Grid.Row="4" Style="{StaticResource Card}" Padding="4">
            <DataGrid x:Name="DlHistoryGrid" SelectionMode="Extended">
              <DataGrid.Columns>
                <DataGridTextColumn Header="@Col.Date" Binding="{Binding C1}" Width="150"/>
                <DataGridTextColumn Header="@Col.Operation" Binding="{Binding C6}" Width="100"/>
                <DataGridTextColumn Header="@Col.Name" Binding="{Binding C2}" Width="*"/>
