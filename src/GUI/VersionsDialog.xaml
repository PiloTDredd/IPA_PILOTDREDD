<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="640" Height="600" MinWidth="520" MinHeight="420" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Brush.Bg}" Foreground="{DynamicResource Brush.Text}" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14" UseLayoutRounding="True">
  <Grid Margin="22">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel>
      <TextBlock x:Name="VerTitle" Style="{StaticResource H1}" FontSize="20"/>
      <TextBlock x:Name="VerSubtitle" Style="{StaticResource Muted}" Margin="0,4,0,0"/>
    </StackPanel>
    <Grid Grid.Row="1" Margin="0,14,0,10">
      <TextBlock x:Name="VerStatus" Style="{StaticResource Muted}" VerticalAlignment="Center" TextWrapping="Wrap" TextTrimming="None" Margin="0,0,180,0"/>
      <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
        <ProgressBar x:Name="VerBusy" IsIndeterminate="True" Width="80" Margin="0,0,10,0" Visibility="Collapsed"/>
        <Button x:Name="VerMoreBtn" x:Uid="Versions.LoadMore"/>
      </StackPanel>
    </Grid>
    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="6">
      <DataGrid x:Name="VerGrid" SelectionMode="Extended">
        <DataGrid.Columns>
          <DataGridTextColumn Header="@Col.Num" Binding="{Binding Index}" Width="50"/>
          <DataGridTextColumn Header="@Col.Version" Binding="{Binding DisplayVersion}" Width="*"/>
          <DataGridTextColumn Header="@Col.VersionId" Binding="{Binding VersionId}" Width="130"/>
        </DataGrid.Columns>
      </DataGrid>
    </Border>
    <Grid Grid.Row="3" Margin="0,14,0,0">
      <CheckBox x:Name="VerAutoPurchase" x:Uid="Common.AutoPurchase" VerticalAlignment="Center"/>
      <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
        <Button x:Name="VerCancelBtn" x:Uid="Common.Cancel" Margin="0,0,8,0" MinWidth="90"/>
        <Button x:Name="VerDownloadBtn" x:Uid="Versions.Download" Style="{StaticResource PrimaryButton}" MinWidth="140"/>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
